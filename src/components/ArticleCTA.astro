---
import type { LocaleCode } from "../content/locales";

interface Props {
  locale: LocaleCode;
  variant?: "inline" | "final" | "sidebar" | "mobile";
}

const { locale, variant = "inline" } = Astro.props;
const path = Astro.url.pathname.toLowerCase();
const isAutomationArticle = /(automation|automate|ai-|ai_|assistant|pdf|document|invoice|workflow|data)/.test(path);
const supportsAudit = locale === "en" || locale === "de";

const websiteCopy = {
  en: {
    title: "Want to know what your website should improve first?",
    text: "Get a free conversion-focused website check. In under a minute you will see the likely bottlenecks, then you can request three human-reviewed recommendations.",
    primary: "Get my free website review",
    secondary: "See our work",
  },
  de: {
    title: "Möchten Sie wissen, was Ihre Website zuerst verbessern sollte?",
    text: "Machen Sie den kostenlosen Conversion-Check. In weniger als einer Minute sehen Sie wahrscheinliche Engpässe und können danach drei menschlich geprüfte Empfehlungen anfordern.",
    primary: "Kostenlosen Website-Check starten",
    secondary: "Unsere Arbeiten ansehen",
  },
};

const automationCopy = {
  en: {
    title: "Could this workflow be simpler?",
    text: "Tell us what still happens manually. We will suggest the simplest practical automation or AI setup before you commit to a project.",
    primary: "Get a free workflow assessment",
    secondary: "See our work",
  },
  de: {
    title: "Könnte dieser Ablauf einfacher sein?",
    text: "Zeigen Sie uns, was heute noch manuell läuft. Wir schlagen die einfachste sinnvolle Automatisierung oder AI-Lösung vor, bevor Sie sich für ein Projekt entscheiden.",
    primary: "Kostenlosen Workflow-Check anfragen",
    secondary: "Unsere Arbeiten ansehen",
  },
};

const fallbackCopy: Record<LocaleCode, { title: string; text: string; primary: string; secondary: string }> = {
  en: websiteCopy.en,
  de: websiteCopy.de,
  hu: { title: "Szeretnéd tudni, min javíts először a weboldaladon?", text: "Kérj egy gyakorlati weboldal-áttekintést, amely a konverzióra, SEO-ra és mérhetőségre fókuszál.", primary: "Ingyenes áttekintés", secondary: "Munkáink" },
  pl: { title: "Chcesz wiedzieć, co poprawić na stronie jako pierwsze?", text: "Poproś o praktyczny przegląd strony pod kątem konwersji, SEO i pomiaru efektów.", primary: "Bezpłatny przegląd", secondary: "Nasze realizacje" },
  es: { title: "¿Quieres saber qué debería mejorar primero tu web?", text: "Solicita una revisión práctica centrada en conversión, SEO y medición.", primary: "Revisión gratuita", secondary: "Ver nuestro trabajo" },
  fr: { title: "Vous voulez savoir quoi améliorer en premier sur votre site ?", text: "Demandez une analyse pratique axée sur la conversion, le SEO et la mesure.", primary: "Analyse gratuite", secondary: "Voir nos réalisations" },
  it: { title: "Vuoi sapere cosa migliorare per primo sul tuo sito?", text: "Richiedi una revisione pratica focalizzata su conversioni, SEO e misurazione.", primary: "Revisione gratuita", secondary: "Vedi i nostri lavori" },
  cz: { title: "Chcete vědět, co na webu zlepšit jako první?", text: "Požádejte o praktickou kontrolu zaměřenou na konverze, SEO a měření.", primary: "Bezplatná kontrola", secondary: "Naše práce" },
  sk: { title: "Chcete vedieť, čo na webe zlepšiť ako prvé?", text: "Požiadajte o praktickú kontrolu zameranú na konverzie, SEO a meranie.", primary: "Bezplatná kontrola", secondary: "Naše práce" },
  pt: { title: "Quer saber o que melhorar primeiro no seu site?", text: "Peça uma análise prática focada em conversão, SEO e medição.", primary: "Análise gratuita", secondary: "Ver trabalhos" },
  da: { title: "Vil du vide, hvad dit website bør forbedre først?", text: "Få en praktisk gennemgang med fokus på konvertering, SEO og måling.", primary: "Gratis gennemgang", secondary: "Se vores arbejde" },
  nl: { title: "Wil je weten wat je website als eerste moet verbeteren?", text: "Vraag een praktische review aan met focus op conversie, SEO en meetbaarheid.", primary: "Gratis review", secondary: "Bekijk ons werk" },
  ja: { title: "サイトで最初に改善すべき点を知りたいですか？", text: "コンバージョン、SEO、計測に焦点を当てた実践的なレビューをご依頼ください。", primary: "無料レビュー", secondary: "実績を見る" },
};

const text = supportsAudit
  ? (isAutomationArticle ? automationCopy[locale as "en" | "de"] : websiteCopy[locale as "en" | "de"])
  : fallbackCopy[locale];

const primaryHref = isAutomationArticle
  ? `/${locale}/contact/?intent=workflow_assessment&source=blog`
  : supportsAudit
    ? `/${locale}/audit/?source=blog`
    : `/${locale}/contact/?intent=website_review&source=blog`;
const secondaryHref = `/${locale}/portfolio/`;
const primaryEvent = isAutomationArticle ? "workflow_assessment_click" : "audit_cta_click";
---

<aside class={`article-cta article-cta-${variant}`} aria-label={text.title}>
  <div>
    <h2>{text.title}</h2>
    <p>{text.text}</p>
  </div>
  <div class="article-cta-actions">
    <a class="button primary" href={primaryHref} data-track-event={primaryEvent} data-track-label={`Article CTA ${variant}`}>{text.primary}</a>
    <a class="button secondary" href={secondaryHref} data-track-event="portfolio_cta_click" data-track-label={`Article CTA ${variant}`}>{text.secondary}</a>
  </div>
</aside>
