  .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:12px}.metric-grid article{padding:18px}.metric-grid strong{display:block;font-size:1.75rem}.metric-grid span{display:block;margin-top:4px;color:var(--muted);font-size:.78rem}
  .report-shell{position:relative;margin-top:36px}.report-heading{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;padding:28px}.report-heading h2{margin:0 0 8px;font-size:clamp(1.8rem,3vw,2.55rem)}.report-heading>div>p:not(.eyebrow){max-width:760px;margin:0;color:var(--muted);line-height:1.58}
