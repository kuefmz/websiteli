---
interface Props { locale?: "en" | "de"; apiBase: string; }
const { locale = "en", apiBase } = Astro.props;
const de = locale === "de";
const c = de ? {
  eyebrow:"Kostenloser Market Scan",
  title:"Gib uns eine URL. Wir kartieren deinen Markt.",
  intro:"Ein echter Live-Scan deiner Website plus öffentliche Markt-, Reddit-, Wettbewerber- und Review-Signale. Keine erfundenen Zahlen.",
  placeholder:"deinefirma.ch",
  button:"Kostenlosen Scan starten",
  scanning:"Wir recherchieren deinen Markt…",
  note:"Kostenlos · keine Karte · Quellen verlinkt · kein Login nötig",
  error:"Der Scan konnte nicht abgeschlossen werden.",
  summary:"Dein Market Scan",
  pages:"Seiten gecrawlt", buyer:"Buyer Signals", reddit:"Reddit-Diskussionen", reviews:"Review-Erwähnungen",
  competitors:"Wettbewerber-Kandidaten", content:"Content-Chancen", ads:"Ad Angles", actions:"Prioritäten",
  scoreTitle:"Website Opportunity Score",
  scoreNote:"Transparenter Heuristik-Score aus beobachtbaren Website-Signalen — kein Umsatzversprechen.",
  priorities:"Was wir zuerst ändern würden",
  diagnostics:"Website-Diagnose",
  signals:"Buyer Signals", pains:"Wiederkehrende Pain Points", compTitle:"Wettbewerber-Kandidaten",
  contentTitle:"Content-Chancen", adTitle:"Ad Angles zum Testen",
  source:"Quelle öffnen", empty:"Für diesen Bereich wurden beim aktuellen Scan keine belastbaren öffentlichen Signale gefunden.",
  newsletterEyebrow:"Report speichern",
  newsletterTitle:"Schick mir den Scan + Websiteli Growth Notes",
  newsletterText:"Erhalte den Link zu diesem Report und praktische Websiteli-Updates zu Websites, SEO, Automation und AI. Du kannst dich jederzeit abmelden.",
  email:"E-Mail", subscribe:"Report + Updates erhalten", sending:"Wird gespeichert…",
  consent:"Ich möchte den Report und Websiteli Growth Notes per E-Mail erhalten und akzeptiere die",
  privacy:"Datenschutzerklärung",
  subscribed:"Danke — du bist angemeldet. Wir verwenden denselben Newsletter-Workflow wie auf websiteli.ch.",
  subscribeError:"Das hat nicht geklappt. Bitte versuche es erneut.",
  subscribeValidation:"Bitte gib eine gültige E-Mail ein und bestätige die Einwilligung.",
  ctaTitle:"Willst du, dass Websiteli die wichtigsten Punkte direkt umsetzt?",
  ctaText:"Wir priorisieren die Chancen und können Website, SEO, Tracking, Ads oder Automatisierung umsetzen.",
  cta:"30-Minuten-Call buchen", again:"Andere Website scannen",
  method:"Öffentliche Datenquellen können Rate-Limits haben. 0 Treffer bedeutet daher nicht automatisch, dass es keine Marktsignale gibt.",
  pass:"OK", review:"Prüfen"
} : {
  eyebrow:"Free Market Scan",
  title:"Give us one URL. We’ll map your market.",
  intro:"A real live crawl of your website plus public market, Reddit, competitor and review signals. No invented numbers.",
  placeholder:"yourbusiness.ch",
  button:"Run my free scan",
  scanning:"Researching your market…",
  note:"Free · no card · sources linked · no login required",
  error:"The scan could not be completed.",
  summary:"Your Market Scan",
  pages:"Pages crawled", buyer:"Buyer signals", reddit:"Reddit discussions", reviews:"Review mentions",
  competitors:"Competitor candidates", content:"Content opportunities", ads:"Ad angles", actions:"Priorities",
  scoreTitle:"Website opportunity score",
  scoreNote:"Transparent heuristic score based on observable website signals — not a revenue promise.",
  priorities:"What we would fix first",
  diagnostics:"Website diagnosis",
  signals:"Buyer signals", pains:"Recurring pain points", compTitle:"Competitor candidates",
  contentTitle:"Content opportunities", adTitle:"Ad angles worth testing",
  source:"Open source", empty:"No sufficiently strong public signals were found for this section in the current scan.",
  newsletterEyebrow:"Save your report",
  newsletterTitle:"Send me this scan + Websiteli Growth Notes",
  newsletterText:"Get this report link plus practical Websiteli updates about websites, SEO, automation and AI. Unsubscribe any time.",
  email:"Email", subscribe:"Send report + updates", sending:"Saving…",
  consent:"I want the report and Websiteli Growth Notes by email and accept the",
  privacy:"Privacy Policy",
  subscribed:"Thanks — you’re subscribed. This uses the same newsletter workflow as websiteli.ch.",
  subscribeError:"That didn’t work. Please try again.",
  subscribeValidation:"Enter a valid email and confirm consent.",
  ctaTitle:"Want Websiteli to implement the highest-impact fixes?",
  ctaText:"We can prioritise the opportunities and implement the website, SEO, tracking, ads or automation.",
  cta:"Book a 30-minute call", again:"Scan another website",
  method:"Public data providers can rate-limit automated requests. A zero count therefore does not always mean zero market activity.",
  pass:"OK", review:"Review"
};
const newsletterEndpoint = "https://script.google.com/macros/s/AKfycbyAMZy4vPe56lUmFA8-Q_MDJ-AS4aJJb0vOeiViGPneWtkYn9LKXla2BmSWflsvuE-lyw/exec";
const privacyPolicyVersion = "2026-06-24";
---

<div class="market-scan" data-market-scan data-api-base={apiBase}>
  <header class="scan-header">
    <a href={`/${locale}/`} class="brand"><img src="/assets/websiteli-logo.png?v=3" alt="" width="38" height="38" /><span>websiteli</span></a>
    <a href={`/${locale}/`} class="back">← Websiteli</a>
  </header>

  <main>
    <section class="hero" data-form-view>
      <div class="hero-proof">Live crawl <span>•</span> Public sources <span>•</span> Actionable recommendations</div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="intro">{c.intro}</p>
      <form data-scan-form novalidate>
        <div class="input-row">
          <span class="url-icon" aria-hidden="true">↗</span>
          <input name="url" inputmode="url" autocomplete="url" placeholder={c.placeholder} required />
          <button type="submit">{c.button}<span>→</span></button>
        </div>
        <p class="status" data-status aria-live="polite"></p>
      </form>
      <p class="trust">✓ {c.note}</p>
      <div class="what-you-get">
        <span>Buyer intent</span><span>Competitors</span><span>Website gaps</span><span>Content ideas</span><span>Ad angles</span>
      </div>
    </section>

    <section class="loading" data-loading hidden>
      <div class="spinner"></div>
      <h2>{c.scanning}</h2>
      <p data-loading-domain></p>
      <div class="loading-steps">
        <span>01 <b>Website crawl</b></span>
        <span>02 <b>Market discovery</b></span>
        <span>03 <b>Signal analysis</b></span>
        <span>04 <b>Priority plan</b></span>
      </div>
      <div class="progress-track"><span data-loading-bar></span></div>
    </section>

    <section class="results" data-results hidden>
      <div class="result-top">
        <div>
          <p class="eyebrow">{c.summary}</p>
          <h2 data-brand></h2>
          <p class="scanned-url" data-scanned-url></p>
        </div>
        <div class="elapsed"><strong data-elapsed>—</strong><span>seconds</span></div>
      </div>

      <div class="result-lead">
        <article class="score-card">
          <div class="score-ring"><strong data-score>—</strong><span>/100</span></div>
          <div><h3>{c.scoreTitle}</h3><p>{c.scoreNote}</p></div>
        </article>
        <article class="priority-preview">
          <p class="eyebrow">{c.priorities}</p>
          <div data-priority-preview></div>
        </article>
      </div>

      <div class="metric-grid">
        <article><strong data-metric="pagesCrawled">0</strong><span>{c.pages}</span></article>
        <article><strong data-metric="buyerSignals">0</strong><span>{c.buyer}</span></article>
        <article><strong data-metric="redditDiscussions">0</strong><span>{c.reddit}</span></article>
        <article><strong data-metric="reviewMentions">0</strong><span>{c.reviews}</span></article>
        <article><strong data-metric="competitorCandidates">0</strong><span>{c.competitors}</span></article>
        <article><strong data-metric="contentOpportunities">0</strong><span>{c.content}</span></article>
        <article><strong data-metric="adAngles">0</strong><span>{c.ads}</span></article>
        <article><strong data-metric="priorityActions">0</strong><span>{c.actions}</span></article>
      </div>

      <section class="report-card wide">
        <div class="card-head"><span>01</span><h3>{c.priorities}</h3></div>
        <div class="action-list" data-list="priorityActions"></div>
      </section>

      <section class="lead-magnet">
        <div>
          <p class="eyebrow">{c.newsletterEyebrow}</p>
          <h2>{c.newsletterTitle}</h2>
          <p>{c.newsletterText}</p>
        </div>
        <form data-market-newsletter novalidate>
          <input name="campaign" type="hidden" value="market-scan-report" />
          <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <label><span>{c.email}</span><input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label>
          <label class="consent">
            <input name="privacyPolicyAccepted" type="checkbox" value="yes" required />
            <span>{c.consent} <a href="/privacy/" target="_blank" rel="noopener">{c.privacy}</a>.</span>
          </label>
          <button type="submit">{c.subscribe}<span>→</span></button>
          <p class="newsletter-status" data-newsletter-status aria-live="polite"></p>
        </form>
      </section>

      <div class="report-grid">
        <section class="report-card">
          <div class="card-head"><span>02</span><h3>{c.diagnostics}</h3></div>
          <div data-list="diagnostics" class="diagnostic-list"></div>
        </section>
        <section class="report-card">
          <div class="card-head"><span>03</span><h3>{c.signals}</h3></div>
          <div data-list="buyerSignals" class="source-list"></div>
        </section>
        <section class="report-card">
          <div class="card-head"><span>04</span><h3>{c.pains}</h3></div>
          <div data-list="painPoints" class="source-list"></div>
        </section>
        <section class="report-card">
          <div class="card-head"><span>05</span><h3>{c.compTitle}</h3></div>
          <div data-list="competitorCandidates" class="source-list"></div>
        </section>
        <section class="report-card">
          <div class="card-head"><span>06</span><h3>{c.contentTitle}</h3></div>
          <div data-list="contentOpportunities" class="source-list"></div>
        </section>
        <section class="report-card">
          <div class="card-head"><span>07</span><h3>{c.adTitle}</h3></div>
          <div data-list="adAngles" class="angle-list"></div>
        </section>
      </div>

      <p class="method-note">{c.method}</p>

      <section class="conversion">
        <p class="eyebrow">Websiteli</p>
        <h2>{c.ctaTitle}</h2>
        <p>{c.ctaText}</p>
        <div class="actions">
          <a href="https://calendly.com/jenifer-ciuciu-kiss-websiteli/30min" target="_blank" rel="noopener noreferrer" data-book>{c.cta}<span>→</span></a>
          <button type="button" data-again>{c.again}</button>
        </div>
      </section>
    </section>
  </main>
</div>

<script define:vars={{ c, locale, newsletterEndpoint, privacyPolicyVersion }}>
(() => {
  const root = document.querySelector("[data-market-scan]");
  if (!root) return;
  const form = root.querySelector("[data-scan-form]");
  const formView = root.querySelector("[data-form-view]");
  const loading = root.querySelector("[data-loading]");
  const results = root.querySelector("[data-results]");
  const status = root.querySelector("[data-status]");
  const apiBase = root.dataset.apiBase.replace(/\/$/, "");
  let latestScan = null;
  let loadingTimer = null;

  const track = (name, params={}) => window.trackWebsiteliEvent?.(name, { event_category:"market_scan", locale, ...params });
  track("market_scan_view");

  function normalize(value) {
    const v = String(value || "").trim();
    if (!v) return null;
    try {
      const url = new URL(/^https?:\/\//i.test(v) ? v : `https://${v}`);
      return url.hostname.includes(".") ? url : null;
    } catch { return null; }
  }
  function clear(el) { while (el?.firstChild) el.firstChild.remove(); }
  function empty(el) { const p=document.createElement("p"); p.className="empty"; p.textContent=c.empty; el.appendChild(p); }

  function sourceItem(item) {
    const article=document.createElement("article");
    const title=document.createElement("strong");
    title.textContent=item.title || item.name || item.context || "Signal";
    article.appendChild(title);
    const detail=item.body || item.snippet || item.context || (item.subreddit ? `r/${item.subreddit}` : "");
    if (detail) { const p=document.createElement("p"); p.textContent=detail.slice(0,320); article.appendChild(p); }
    const href=item.url || item.source;
    if (href) {
      const a=document.createElement("a"); a.href=href; a.target="_blank"; a.rel="noopener noreferrer";
      a.textContent=c.source+" ↗"; a.addEventListener("click",()=>track("market_scan_source_click",{source_type:"report"})); article.appendChild(a);
    }
    return article;
  }

  function renderSourceList(key, items) {
    const el=root.querySelector(`[data-list="${key}"]`); clear(el);
    if (!items?.length) return empty(el);
    items.slice(0,8).forEach((item)=>el.appendChild(sourceItem(item)));
  }

  function renderActions(items) {
    const el=root.querySelector('[data-list="priorityActions"]'); clear(el);
    const preview=root.querySelector("[data-priority-preview]"); clear(preview);
    if(!items?.length){ empty(el); return; }
    items.forEach((item,i)=>{
      const article=document.createElement("article");
      const meta=document.createElement("div"); meta.className="action-meta";
      const priority=document.createElement("span"); priority.textContent=item.priority;
      const area=document.createElement("span"); area.textContent=item.area;
      meta.append(priority,area);
      const h=document.createElement("h4"); h.textContent=item.title;
      const p=document.createElement("p"); p.textContent=item.detail;
      article.append(meta,h,p); el.appendChild(article);
      if(i<3){
        const row=document.createElement("div"); const n=document.createElement("b"); n.textContent=String(i+1).padStart(2,"0");
        const text=document.createElement("span"); text.textContent=item.title; row.append(n,text); preview.appendChild(row);
      }
    });
  }

  function renderDiagnostics(items) {
    const el=root.querySelector('[data-list="diagnostics"]'); clear(el);
    if(!items?.length){ empty(el); return; }
    items.forEach((item)=>{
      const row=document.createElement("div"); row.className="diagnostic-row";
      const copy=document.createElement("div"); const strong=document.createElement("strong"); strong.textContent=item.label;
      const small=document.createElement("small"); small.textContent=item.detail; copy.append(strong,small);
      const badge=document.createElement("span"); badge.className=item.passed ? "pass" : "review"; badge.textContent=item.passed ? c.pass : c.review;
      row.append(copy,badge); el.appendChild(row);
    });
  }

  function renderAngles(items) {
    const el=root.querySelector('[data-list="adAngles"]'); clear(el);
    if(!items?.length){ empty(el); return; }
    items.forEach((textValue,i)=>{
      const article=document.createElement("article"); const n=document.createElement("span"); n.textContent=String(i+1).padStart(2,"0");
      const p=document.createElement("p"); p.textContent=textValue; article.append(n,p); el.appendChild(article);
    });
  }

  function render(data) {
    latestScan=data;
    root.querySelector("[data-brand]").textContent=data.brand || "Market scan";
    root.querySelector("[data-scanned-url]").textContent=data.scannedUrl || "";
    root.querySelector("[data-elapsed]").textContent=Math.max(.1,(data.elapsedMs||0)/1000).toFixed(1);
    root.querySelector("[data-score]").textContent=String(data.website?.opportunityScore ?? "—");
    Object.entries(data.summary||{}).forEach(([key,value]) => {
      const el=root.querySelector(`[data-metric="${key}"]`); if(el) el.textContent=String(value ?? 0);
    });
    renderActions(data.priorityActions);
    renderDiagnostics(data.website?.diagnostics);
    renderSourceList("buyerSignals",data.buyerSignals);
    renderSourceList("painPoints",data.painPoints);
    renderSourceList("competitorCandidates",data.competitorCandidates);
    renderSourceList("contentOpportunities",data.contentOpportunities);
    renderAngles(data.adAngles);
  }

  function startLoadingProgress(domain){
    root.querySelector("[data-loading-domain]").textContent=domain;
    const bar=root.querySelector("[data-loading-bar]"); let pct=12; bar.style.width=pct+"%";
    loadingTimer=window.setInterval(()=>{ pct=Math.min(90,pct+Math.max(2,(92-pct)*.1)); bar.style.width=pct+"%"; },450);
  }
  function stopLoadingProgress(){
    if(loadingTimer) window.clearInterval(loadingTimer);
    loadingTimer=null; const bar=root.querySelector("[data-loading-bar]"); if(bar) bar.style.width="100%";
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault(); status.textContent="";
    const url=normalize(new FormData(form).get("url"));
    if(!url){ status.textContent=c.error; return; }
    const button=form.querySelector('button[type="submit"]'); button?.setAttribute("disabled","true");
    formView.hidden=true; results.hidden=true; loading.hidden=false; startLoadingProgress(url.hostname);
    track("market_scan_start",{website_domain:url.hostname});

    try {
      const response=await fetch(`${apiBase}/api/scan`,{
        method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({url:url.toString()})
      });
      const data=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(data.error || c.error);
      render(data); stopLoadingProgress();
      window.setTimeout(()=>{ loading.hidden=true; results.hidden=false; window.scrollTo({top:0,behavior:"smooth"}); },220);
      track("market_scan_complete",{website_domain:url.hostname,...data.summary,opportunity_score:data.website?.opportunityScore,elapsed_ms:data.elapsedMs});
    } catch (error) {
      stopLoadingProgress(); loading.hidden=true; formView.hidden=false;
      status.textContent=error?.message || c.error;
      track("market_scan_error",{website_domain:url.hostname,error_message:String(error?.message||"unknown")});
    } finally { button?.removeAttribute("disabled"); }
  });

  const newsletterForm=root.querySelector("[data-market-newsletter]");
  newsletterForm?.addEventListener("submit", async (event)=>{
    event.preventDefault();
    const fd=new FormData(newsletterForm);
    const email=String(fd.get("email")||"").trim();
    const honeypot=String(fd.get("website")||"").trim();
    const accepted=String(fd.get("privacyPolicyAccepted")||"")==="yes";
    const msg=newsletterForm.querySelector("[data-newsletter-status]");
    const button=newsletterForm.querySelector('button[type="submit"]');

    if(honeypot){ newsletterForm.reset(); if(msg) msg.textContent=c.subscribed; return; }
    if(!newsletterForm.checkValidity() || !email || !accepted){
      newsletterForm.reportValidity(); if(msg) msg.textContent=c.subscribeValidation; return;
    }

    const attribution=window.websiteliGetAttribution?.() || {};
    const scannedUrl=latestScan?.scannedUrl || "";
    const payload={
      type:"newsletter",
      email,
      campaign:"market-scan-report",
      sourceUrl:window.location.href,
      language:document.documentElement.lang || locale,
      website:honeypot,
      metadata:{
        language:document.documentElement.lang || locale,
        country:window.websiteliPricing?.country || "",
        currency:window.websiteliPricing?.currency || "",
        market:window.websiteliPricing?.pricingMarket || "",
        pageUrl:window.location.href,
        referrer:document.referrer,
        userAgent:navigator.userAgent,
        campaign:"market-scan-report",
        scannedUrl,
        scannedDomain:(()=>{try{return new URL(scannedUrl).hostname}catch{return ""}})(),
        opportunityScore:latestScan?.website?.opportunityScore ?? "",
        buyerSignals:latestScan?.summary?.buyerSignals ?? 0,
        competitorCandidates:latestScan?.summary?.competitorCandidates ?? 0,
        priorityActions:latestScan?.summary?.priorityActions ?? 0,
        utm_source:attribution.utm_source || "",
        utm_medium:attribution.utm_medium || "",
        utm_campaign:attribution.utm_campaign || "",
        utm_term:attribution.utm_term || "",
        utm_content:attribution.utm_content || "",
        utm_id:attribution.utm_id || "",
        gclid:attribution.gclid || "",
        gbraid:attribution.gbraid || "",
        wbraid:attribution.wbraid || "",
        fbclid:attribution.fbclid || "",
        msclkid:attribution.msclkid || "",
        landingPage:attribution.landingPage || "",
        firstSeenAt:attribution.firstSeenAt || "",
        first_utm_source:attribution.first_utm_source || "",
        first_utm_medium:attribution.first_utm_medium || "",
        first_utm_campaign:attribution.first_utm_campaign || "",
        first_gclid:attribution.first_gclid || "",
        first_fbclid:attribution.first_fbclid || "",
        privacyPolicyAccepted:true,
        privacyPolicyVersion,
        privacyPolicyUrl:`${window.location.origin}/privacy/`,
        timestamp:new Date().toISOString()
      }
    };

    button?.setAttribute("disabled","true"); if(msg) msg.textContent=c.sending;
    try{
      await fetch(newsletterEndpoint,{
        method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(payload)
      });
      newsletterForm.reset(); if(msg) msg.textContent=c.subscribed;
      try{localStorage.setItem("websiteli_market_scan_subscribed","true")}catch{}
      window.trackWebsiteliEvent?.("newsletter_subscribe",{
        event_category:"lead",event_label:"Market Scan report",campaign:"market-scan-report",locale,
        source_path:window.location.pathname,privacy_policy_accepted:"yes"
      });
      track("market_scan_email_capture",{website_domain:payload.metadata.scannedDomain,opportunity_score:payload.metadata.opportunityScore});
    }catch(error){
      if(msg) msg.textContent=c.subscribeError;
      track("market_scan_email_error",{error_message:String(error?.message||"unknown")});
    }finally{button?.removeAttribute("disabled");}
  });

  root.querySelector("[data-again]")?.addEventListener("click",()=>{
    results.hidden=true; formView.hidden=false; form?.reset(); status.textContent=""; latestScan=null;
    window.scrollTo({top:0,behavior:"smooth"}); track("market_scan_again");
  });
  root.querySelector("[data-book]")?.addEventListener("click",()=>track("market_scan_booking_click",{
    website_domain:(()=>{try{return new URL(latestScan?.scannedUrl||"").hostname}catch{return ""}})(),
    opportunity_score:latestScan?.website?.opportunityScore ?? ""
  }));
})();
</script>

<style>
  :global(body){margin:0;background:#0d1015;color:#f7f4ed;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  [hidden]{display:none!important}.market-scan{min-height:100vh;background:radial-gradient(circle at 50% -10%,rgba(192,149,94,.2),transparent 32%),#0d1015}
  .scan-header{max-width:1180px;margin:auto;padding:24px 28px;display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;gap:10px;color:#fff;text-decoration:none;font-weight:800;font-size:1.1rem}.brand img{border-radius:10px}.back{color:#b8bbc3;text-decoration:none;font-size:.92rem}
  main{max-width:1100px;margin:auto;padding:58px 28px 100px}.hero{text-align:center;max-width:900px;margin:4vh auto 0}
  .hero-proof{display:inline-flex;gap:8px;flex-wrap:wrap;justify-content:center;border:1px solid #2a3039;border-radius:99px;padding:8px 13px;color:#9298a4;font-size:.78rem;margin-bottom:24px;background:#12161c}.hero-proof span{color:#c79a63}
  .eyebrow{text-transform:uppercase;letter-spacing:.14em;color:#c99a61;font-size:.76rem;font-weight:800;margin:0 0 16px}
  h1{font-size:clamp(2.8rem,7vw,5.8rem);line-height:.95;letter-spacing:-.06em;margin:0 auto 24px;max-width:960px}.intro{font-size:clamp(1.05rem,2vw,1.28rem);line-height:1.6;color:#b9bdc7;max-width:770px;margin:0 auto 34px}
  .input-row{display:flex;align-items:center;background:#171b22;border:1px solid #353b45;border-radius:18px;padding:7px 7px 7px 15px;max-width:830px;margin:auto;box-shadow:0 26px 80px rgba(0,0,0,.32)}.url-icon{color:#777e88}
