---
interface Props { locale?: "en" | "de"; apiBase: string; }
const { locale = "en", apiBase } = Astro.props;
const de = locale === "de";
const c = de ? {
  eyebrow:"Kostenloser Market Scan",
  title:"Gib uns eine URL. Wir kartieren deinen Markt.",
  intro:"Ein Live-Scan deiner Website plus öffentliche Markt-, Reddit-, Wettbewerber- und Review-Signale — mit nachvollziehbaren Quellen statt erfundenen Zahlen.",
  placeholder:"deinefirma.ch",
  button:"Kostenlosen Scan starten",
  scanning:"Wir recherchieren deinen Markt…",
  note:"Kostenlos · keine Karte · Quellen verlinkt · kein Login nötig",
  error:"Der Scan konnte nicht abgeschlossen werden.",
  summary:"Dein Market Scan",
  pages:"Seiten gecrawlt", buyer:"Buyer Signals", reddit:"Reddit-Diskussionen", reviews:"Review-Erwähnungen",
  competitors:"Wettbewerber-Kandidaten", content:"Content-Chancen", ads:"Ad Angles", actions:"Prioritäten",
  scoreTitle:"Website Fundamentals Score",
  scoreNote:"Transparenter Heuristik-Score aus 9 beobachtbaren Website-Signalen — kein Umsatzversprechen.",
  priorities:"Priorisierter Aktionsplan",
  diagnostics:"Website-Diagnose",
  signals:"Buyer Signals", pains:"Wiederkehrende Pain Points", compTitle:"Wettbewerber-Kandidaten",
  redditTitle:"Reddit-Diskussionen", reviewsTitle:"Review-Erwähnungen",
  contentTitle:"Content-Chancen", adTitle:"Ad Angles zum Testen",
  source:"Quelle öffnen", empty:"Für diesen Bereich wurden beim aktuellen Scan keine belastbaren öffentlichen Signale gefunden.",
  reportTitle:"Dein vollständiger Market Scan",
  reportIntro:"Prüfe jetzt den vollständigen Report. Wenn die Vorschau endet, kannst du dir den kompletten Market Scan kostenlos per E-Mail schicken lassen.",
  preview:"Kostenlose Report-Vorschau",
  newsletterEyebrow:"Vollständiger Report",
  locksIn:"Report wird gesperrt in",
  locked:"Deine Report-Vorschau ist abgelaufen",
  lockedText:"Gib deine E-Mail ein und wir schicken dir den vollständigen Market Scan mit allen Diagnosen, Quellen, Buyer Signals, Wettbewerbern, Content-Chancen und Ad Angles.",
  email:"E-Mail", subscribe:"Vollständigen Report senden", sending:"Report wird gesendet…",
  consent:"Ich möchte meinen Market-Scan-Report und Websiteli Growth Notes per E-Mail erhalten und akzeptiere die",
  privacy:"Datenschutzerklärung",
  subscribed:"Gesendet — prüfe deinen Posteingang. Dein vollständiger Market Scan ist unterwegs.",
  subscribeError:"Das hat nicht geklappt. Bitte versuche es erneut.",
  subscribeValidation:"Bitte gib eine gültige E-Mail ein und bestätige die Einwilligung.",
  ctaTitle:"Soll Websiteli die wichtigsten Punkte direkt umsetzen?",
  ctaText:"Wir priorisieren die Chancen und können Website, SEO, Tracking, Ads oder Automatisierung umsetzen.",
  cta:"30-Minuten-Call buchen", again:"Andere Website scannen",
  method:"Öffentliche Datenquellen können Rate-Limits haben. 0 Treffer bedeutet daher nicht automatisch, dass es keine Marktsignale gibt.",
  evidenceSnapshot:"Executive Summary",
  execEyebrow:"Was wirklich zählt", execPositioning:"Erkannte Positionierung", execOpportunity:"Größte Chance", execConfidence:"Positionierungs-Sicherheit", execSignals:"Belastbare externe Signale",
  demandCategory:"Kundennachfrage", customerVoiceCategory:"Kundenstimme", competitionCategory:"Wettbewerb", growthCategory:"Wachstumschancen",
  actionSummary:"Die wichtigsten nächsten Schritte, nach Wirkung und Themenbereich geordnet.",
  demandSummary:"Was potenzielle Kunden suchen, fragen und worüber sie sich beschweren.",
  evidenceSummary:"Öffentliche Gespräche und Reviews, die die Marktanalyse stützen.",
  competitionSummary:"Welche Alternativen und Wettbewerber in der Recherche wiederholt auftauchen.",
  growthSummary:"Konkrete Content- und Werbeansätze, die aus den gefundenen Signalen abgeleitet wurden.",
  pass:"Gesund", review:"Chance",
  healthy:"Gesund", opportunities:"Chancen",
  diagnosisGood:"Die Website ist strukturell solide. Die wichtigsten Grundlagen sind vorhanden.",
  diagnosisImprove:"Die Website ist insgesamt solide, mit einigen klaren Chancen für bessere Sichtbarkeit und Conversion.",
  priority:"Priorität", area:"Bereich", scanTime:"Scan-Zeit"
} : {
  eyebrow:"Free Market Scan",
  title:"Give us one URL. We’ll map your market.",
  intro:"A live crawl of your website plus public market, Reddit, competitor and review signals — with traceable sources instead of invented numbers.",
  placeholder:"yourbusiness.ch",
  button:"Run my free scan",
  scanning:"Researching your market…",
  note:"Free · no card · sources linked · no login required",
  error:"The scan could not be completed.",
  summary:"Your Market Scan",
  pages:"Pages crawled", buyer:"Buyer signals", reddit:"Reddit discussions", reviews:"Review mentions",
  competitors:"Competitor candidates", content:"Content opportunities", ads:"Ad angles", actions:"Priorities",
  scoreTitle:"Website fundamentals score",
  scoreNote:"Transparent heuristic score based on 9 observable website signals — not a revenue promise.",
  priorities:"Priority action plan",
  diagnostics:"Website diagnosis",
  signals:"Buyer signals", pains:"Recurring pain points", compTitle:"Competitor candidates",
  redditTitle:"Reddit discussions", reviewsTitle:"Review mentions",
  contentTitle:"Content opportunities", adTitle:"Ad angles worth testing",
  source:"Open source", empty:"No sufficiently strong public signals were found for this section in the current scan.",
  reportTitle:"Your complete Market Scan",
  reportIntro:"Review the full report now. When the preview ends, you can have the complete Market Scan sent to your inbox.",
  preview:"Free report preview",
  newsletterEyebrow:"Full report",
  locksIn:"Report locks in",
  locked:"Your report preview has ended",
  lockedText:"Enter your email and we’ll send the complete Market Scan with every diagnosis, source, buyer signal, competitor, content opportunity and ad angle.",
  email:"Email", subscribe:"Send my full report", sending:"Sending your report…",
  consent:"I want my Market Scan report and Websiteli Growth Notes by email and accept the",
  privacy:"Privacy Policy",
  subscribed:"Sent — check your inbox. Your complete Market Scan is on its way.",
  subscribeError:"That didn’t work. Please try again.",
  subscribeValidation:"Enter a valid email and confirm consent.",
  ctaTitle:"Want Websiteli to implement the highest-impact fixes?",
  ctaText:"We can prioritise the opportunities and implement the website, SEO, tracking, ads or automation.",
  cta:"Book a 30-minute call", again:"Scan another website",
  method:"Public data providers can rate-limit automated requests. A zero count therefore does not always mean zero market activity.",
  evidenceSnapshot:"Executive summary",
  execEyebrow:"What actually matters", execPositioning:"Detected positioning", execOpportunity:"Biggest opportunity", execConfidence:"Positioning confidence", execSignals:"Relevant external signals",
  demandCategory:"Customer demand", customerVoiceCategory:"Customer voice", competitionCategory:"Competitive landscape", growthCategory:"Growth opportunities",
  actionSummary:"The most important next steps, organised by impact and focus area.",
  demandSummary:"What potential customers are actively looking for, asking about and struggling with.",
  evidenceSummary:"Public conversations and review mentions that support the market findings.",
  competitionSummary:"The alternatives and competitors that repeatedly surfaced in the research.",
  growthSummary:"Concrete content and campaign ideas derived from the market signals we found.",
  pass:"Healthy", review:"Opportunity",
  healthy:"Healthy", opportunities:"Opportunities",
  diagnosisGood:"The website fundamentals look strong overall, with the key structural elements in place.",
  diagnosisImprove:"The site looks solid overall, with a few clear opportunities to improve visibility and conversion.",
  priority:"Priority", area:"Area", scanTime:"Scan time"
};
const newsletterEndpoint = "https://script.google.com/macros/s/AKfycbyAMZy4vPe56lUmFA8-Q_MDJ-AS4aJJb0vOeiViGPneWtkYn9LKXla2BmSWflsvuE-lyw/exec";
const privacyPolicyVersion = "2026-06-24";
---

<main class="market-scan" data-market-scan data-api-base={apiBase}>
  <section class="scan-hero section-shell" data-form-view>
    <div class="scan-hero-copy">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="scan-intro">{c.intro}</p>
      <form class="scan-form" data-scan-form novalidate>
        <label class="scan-url">
          <span class="url-prefix" aria-hidden="true">↗</span>
          <input name="url" inputmode="url" autocomplete="url" placeholder={c.placeholder} required />
          <button class="button" type="submit">{c.button}<span aria-hidden="true">→</span></button>
        </label>
        <p class="status" data-status aria-live="polite"></p>
      </form>
      <p class="scan-trust">✓ {c.note}</p>
      <div class="scan-tags" aria-label="Included in the scan">
        <span>Buyer intent</span><span>Competitors</span><span>Website gaps</span><span>Content ideas</span><span>Ad angles</span>
      </div>
    </div>
    <aside class="market-map-visual" aria-hidden="true">
      <div class="market-map-top">
        <span>What the scan connects</span>
        <span class="market-map-live">● Live research</span>
      </div>

      <div class="market-map-stage">
        <svg class="market-map-lines" viewBox="0 0 560 420" role="presentation">
          <path d="M280 210 C220 185 180 145 130 108" />
          <path d="M280 210 C340 180 385 142 435 105" />
          <path d="M280 210 C215 220 170 255 112 288" />
          <path d="M280 210 C350 225 397 258 455 292" />
          <path d="M280 210 C280 155 280 115 280 72" />
          <path d="M280 210 C280 268 280 310 280 352" />
        </svg>

        <div class="map-node center-node">
          <span class="node-icon">↗</span>
          <div>
            <strong>Your website</strong>
            <small>One URL in</small>
          </div>
        </div>

        <div class="map-node node-top">
          <span class="node-dot"></span>
          <div><strong>Website gaps</strong><small>SEO · UX · conversion</small></div>
        </div>
        <div class="map-node node-left-top">
          <span class="node-dot"></span>
          <div><strong>Buyer signals</strong><small>Questions · intent · demand</small></div>
        </div>
        <div class="map-node node-right-top">
          <span class="node-dot"></span>
          <div><strong>Competitors</strong><small>Alternatives · positioning</small></div>
        </div>
        <div class="map-node node-left-bottom">
          <span class="node-dot"></span>
          <div><strong>Reddit & reviews</strong><small>Pain points · language</small></div>
        </div>
        <div class="map-node node-right-bottom">
          <span class="node-dot"></span>
          <div><strong>Content ideas</strong><small>Topics · objections</small></div>
        </div>
        <div class="map-node node-bottom">
          <span class="node-dot"></span>
          <div><strong>Ad angles</strong><small>Messages worth testing</small></div>
        </div>
      </div>

      <div class="market-map-footer">
        <span><b>01</b> Crawl</span>
        <span><b>02</b> Discover</span>
        <span><b>03</b> Connect</span>
        <span><b>04</b> Prioritise</span>
      </div>
    </aside>
  </section>

  <section class="scan-loading section-shell" data-loading hidden>
    <div class="loading-card">
      <div class="spinner" aria-hidden="true"></div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.scanning}</h2>
      <p data-loading-domain></p>
      <div class="loading-steps">
        <span><b>01</b> Website crawl</span>
        <span><b>02</b> Market discovery</span>
        <span><b>03</b> Signal analysis</span>
        <span><b>04</b> Priority plan</span>
      </div>
      <div class="progress-track"><span data-loading-bar></span></div>
    </div>
  </section>

  <section class="scan-results section-shell" data-results hidden>
    <header class="result-header">
      <div>
        <p class="eyebrow">{c.summary}</p>
        <h1 data-brand></h1>
        <p class="scanned-url" data-scanned-url></p>
      </div>
      <div class="scan-time"><span>{c.scanTime}</span><strong><span data-elapsed>—</span>s</strong></div>
    </header>

    <section class="executive-brief">
      <div class="executive-main">
        <p class="eyebrow">{c.execEyebrow}</p>
        <h2 data-exec-headline></h2>
        <p class="executive-note" data-exec-market-note></p>
        <div class="executive-chips">
          <span data-exec-site-type></span>
          <span data-exec-confidence></span>
          <span data-coverage-note></span>
        </div>
      </div>

      <div class="executive-side">
        <article class="exec-card">
          <span>{c.execPositioning}</span>
          <strong data-exec-positioning></strong>
        </article>
        <article class="exec-card accent">
          <span>{c.execOpportunity}</span>
          <strong data-exec-action></strong>
        </article>
      </div>
    </section>

    <section class="score-strip">
      <article class="score-card compact">
        <div class="score-ring"><strong data-score>—</strong><span>/100</span></div>
        <div><span class="micro-label">{c.scoreTitle}</span><p>{c.scoreNote}</p></div>
      </article>
      <article class="signal-card">
        <span class="micro-label">{c.execSignals}</span>
        <strong data-relevant-signal-count>0</strong>
        <p data-signal-quality-note></p>
      </article>
      <article class="priority-card compact">
        <span class="micro-label">{c.priorities}</span>
        <div data-priority-preview></div>
      </article>
    </section>

    <section class="report-shell" data-report-shell>
      <header class="report-heading">
        <div>
          <p class="eyebrow">{c.preview}</p>
          <h2>{c.reportTitle}</h2>
          <p>{c.reportIntro}</p>
        </div>
        <div class="report-timer" data-report-timer>
          <span>{c.locksIn}</span>
          <strong data-countdown>1:30</strong>
        </div>
      </header>

      <div class="research-guardrail" data-market-quality-note hidden>
        <span class="research-guardrail-icon" aria-hidden="true">✓</span>
        <div>
          <strong data-market-quality-title></strong>
          <p data-market-quality-copy></p>
        </div>
      </div>

      <div class="report-content" data-report-content>
        <section class="report-section action-plan-section">
          <div class="section-title"><span>01</span><div><h3>{c.priorities}</h3><p>{c.actionSummary}</p></div></div>
          <div class="action-groups" data-action-groups></div>
        </section>

        <section class="report-section diagnosis-section">
          <div class="section-title"><span>02</span><div><h3>{c.diagnostics}</h3><p data-diagnosis-summary></p></div></div>
          <div class="diagnosis-groups">
            <div class="diagnosis-group">
              <div class="group-heading">
                <strong>{c.healthy}</strong>
                <span data-diagnosis-healthy-count>0</span>
              </div>
              <div class="diagnosis-card-grid" data-diagnostics-healthy></div>
            </div>
            <div class="diagnosis-group">
              <div class="group-heading">
                <strong>{c.opportunities}</strong>
                <span data-diagnosis-opportunity-count>0</span>
              </div>
              <div class="diagnosis-card-grid" data-diagnostics-opportunities></div>
            </div>
          </div>
        </section>

        <section class="report-section category-section" data-market-section>
          <div class="section-title"><span>03</span><div><h3>{c.demandCategory}</h3><p>{c.demandSummary}</p></div></div>
          <div class="report-two-col">
            <div class="insight-block">
              <div class="insight-heading"><strong>{c.signals}</strong><span data-count-buyer></span></div>
              <div class="source-list" data-buyer-signals></div>
            </div>
            <div class="insight-block">
              <div class="insight-heading"><strong>{c.pains}</strong><span data-count-pains></span></div>
              <div class="source-list" data-pain-points></div>
            </div>
          </div>
        </section>

        <section class="report-section category-section" data-market-section>
          <div class="section-title"><span>04</span><div><h3>{c.customerVoiceCategory}</h3><p>{c.evidenceSummary}</p></div></div>
          <div class="report-two-col">
            <div class="insight-block">
              <div class="insight-heading"><strong>{c.redditTitle}</strong><span data-count-reddit></span></div>
              <div class="source-list" data-reddit></div>
            </div>
            <div class="insight-block">
              <div class="insight-heading"><strong>{c.reviewsTitle}</strong><span data-count-reviews></span></div>
              <div class="source-list" data-reviews></div>
            </div>
          </div>
        </section>

        <section class="report-section category-section" data-market-section>
          <div class="section-title"><span>05</span><div><h3>{c.competitionCategory}</h3><p>{c.competitionSummary}</p></div></div>
          <div class="competitor-grid" data-competitors></div>
        </section>

        <section class="report-section category-section" data-market-section>
          <div class="section-title"><span>06</span><div><h3>{c.growthCategory}</h3><p>{c.growthSummary}</p></div></div>
          <div class="report-two-col">
            <div class="insight-block">
              <div class="insight-heading"><strong>{c.contentTitle}</strong><span data-count-content></span></div>
              <div class="source-list" data-content-opportunities></div>
            </div>
            <div class="insight-block">
              <div class="insight-heading"><strong>{c.adTitle}</strong><span data-count-ads></span></div>
              <div class="angle-list" data-ad-angles></div>
            </div>
          </div>
        </section>
      </div>

      <div class="report-lock" data-report-lock hidden>
        <div class="lock-card">
          <span class="lock-mark" aria-hidden="true">✦</span>
          <p class="eyebrow">{c.newsletterEyebrow ?? c.preview}</p>
          <h2>{c.locked}</h2>
          <p>{c.lockedText}</p>
          <form data-market-newsletter novalidate>
            <input name="campaign" type="hidden" value="market-scan-report" />
            <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
            <label class="email-field"><span>{c.email}</span><input name="email" type="email" autocomplete="email" required placeholder="you@company.com" /></label>
            <label class="consent">
              <input name="privacyPolicyAccepted" type="checkbox" value="yes" required />
              <span>{c.consent} <a href="/privacy/" target="_blank" rel="noopener">{c.privacy}</a>.</span>
            </label>
            <button class="button" type="submit">{c.subscribe}<span aria-hidden="true">→</span></button>
            <p class="newsletter-status" data-newsletter-status aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <p class="method-note">{c.method}</p>

    <section class="scan-cta">
      <div>
        <p class="eyebrow">Websiteli</p>
        <h2>{c.ctaTitle}</h2>
        <p>{c.ctaText}</p>
      </div>
      <div class="cta-actions">
        <a class="button" href="https://calendly.com/jenifer-ciuciu-kiss-websiteli/30min" target="_blank" rel="noopener noreferrer" data-book>{c.cta}<span>→</span></a>
        <button class="button secondary" type="button" data-again>{c.again}</button>
      </div>
    </section>
  </section>
</main>

<script define:vars={{ c, locale, newsletterEndpoint, privacyPolicyVersion }}>
(() => {
  const root = document.querySelector("[data-market-scan]");
  if (!root) return;
  const form = root.querySelector("[data-scan-form]");
  const formView = root.querySelector("[data-form-view]");
  const loading = root.querySelector("[data-loading]");
  const results = root.querySelector("[data-results]");
  const status = root.querySelector("[data-status]");
  const apiBase = root.dataset.apiBase.replace(/\/$/, "");
  const PREVIEW_SECONDS = 90;
  let latestScan = null;
  let loadingTimer = null;
  let reportTimer = null;

  const track = (name, params={}) => window.trackWebsiteliEvent?.(name, { event_category:"market_scan", locale, ...params });
  track("market_scan_view");

  const clear = (el) => { while (el?.firstChild) el.firstChild.remove(); };
  const text = (value) => String(value ?? "").trim();
  const makeEmpty = () => {
    const p=document.createElement("p"); p.className="empty"; p.textContent=c.empty; return p;
  };
  const normalize = (value) => {
    const v=text(value);
    if(!v) return null;
    try { const url=new URL(/^https?:\/\//i.test(v)?v:`https://${v}`); return url.hostname.includes(".")?url:null; }
    catch { return null; }
  };

  function actionCategory(area){
    const a=String(area||"").toLowerCase();
    if(/seo|search|technical|measurement/.test(a)) return locale==="de"?"Sichtbarkeit & Technik":"Visibility & foundation";
    if(/conversion|ux|lead/.test(a)) return locale==="de"?"Conversion & UX":"Conversion & UX";
    if(/messaging|positioning|brand/.test(a)) return locale==="de"?"Messaging & Positionierung":"Messaging & positioning";
    if(/content|growth|experiment|ads?/.test(a)) return locale==="de"?"Wachstum & Nachfrage":"Growth & demand";
    return locale==="de"?"Weitere Chancen":"Other opportunities";
  }

  function renderPriorities(items){
    const preview=root.querySelector("[data-priority-preview]");
    const grouped=root.querySelector("[data-action-groups]");
    clear(preview); clear(grouped);
    if(!items?.length){ preview.appendChild(makeEmpty()); grouped.appendChild(makeEmpty()); return; }

    items.slice(0,3).forEach((item,i)=>{
      const row=document.createElement("div"); row.className="priority-row";
      const num=document.createElement("b"); num.textContent=String(i+1).padStart(2,"0");
      const copy=document.createElement("div"); copy.className="priority-copy";
      const title=document.createElement("span"); title.textContent=item.title;
      const meta=document.createElement("small"); meta.textContent=`${item.priority || c.priority} · ${actionCategory(item.area)}`;
      copy.append(title,meta); row.append(num,copy); preview.appendChild(row);
    });

    const groups=new Map();
    items.forEach((item,i)=>{
      const category=actionCategory(item.area);
      if(!groups.has(category)) groups.set(category,[]);
      groups.get(category).push({...item,_index:i});
    });

    groups.forEach((groupItems,category)=>{
      const section=document.createElement("section"); section.className="action-group";
      const header=document.createElement("div"); header.className="action-group-heading";
      const h=document.createElement("h4"); h.textContent=category;
      const count=document.createElement("span"); count.textContent=String(groupItems.length);
      header.append(h,count); section.appendChild(header);

      const grid=document.createElement("div"); grid.className="action-list";
      groupItems.forEach(item=>{
        const article=document.createElement("article");
        const top=document.createElement("div"); top.className="action-top";
        const num=document.createElement("span"); num.className="action-number"; num.textContent=String(item._index+1).padStart(2,"0");
        const badge=document.createElement("small"); badge.className=`priority-badge ${String(item.priority||"").toLowerCase()}`; badge.textContent=item.priority || c.priority;
        top.append(num,badge);
        const h=document.createElement("h5"); h.textContent=item.title;
        const p=document.createElement("p"); p.textContent=item.detail || "";
        article.append(top,h,p); grid.appendChild(article);
      });
      section.appendChild(grid); grouped.appendChild(section);
    });
  }

  function diagnosisCopy(item){
    const label=item.label || "";
    const deCopy=locale==="de";
    const map={
      "Homepage title":{
        title:deCopy?"Klare Seitentitel":"Clear page titles",
        healthy:deCopy?"Die wichtigsten Seiten verwenden klare Titel, die für Nutzer und Suchmaschinen verständlich sind.":"Key pages use clear titles that are understandable to both users and search engines.",
        opportunity:deCopy?"Die Seitentitel könnten Angebot und Nutzen klarer kommunizieren.":"Page titles could communicate the offer and value proposition more clearly."
      },
      "Meta description":{
        title:deCopy?"Suchbeschreibungen vorhanden":"Search descriptions in place",
        healthy:deCopy?"Wichtige Seiten enthalten unterstützende Beschreibungen für die Suchergebnisse.":"Important pages include supporting descriptions for search visibility.",
        opportunity:deCopy?"Einige Suchbeschreibungen fehlen oder könnten den Nutzen stärker vermitteln.":"Some search descriptions are missing or could communicate more value."
      },
      "Clear H1 structure":{
        title:deCopy?"Klare Seitenstruktur":"Strong page structure",
        healthy:deCopy?"Die Überschriften-Hierarchie wirkt klar und gut lesbar.":"The heading hierarchy looks clear and easy to scan.",
        opportunity:deCopy?"Die Hauptbotschaft könnte durch eine klarere Überschriften-Struktur stärker werden.":"The main message could be strengthened with a clearer heading structure."
      },
      "Conversion CTA":{
        title:deCopy?"Klarer Conversion-Pfad":"Visible conversion path",
        healthy:deCopy?"Besucher erhalten einen klaren nächsten Schritt.":"Visitors are given a clear next step to take.",
        opportunity:deCopy?"Der primäre Call-to-Action könnte sichtbarer und konsistenter sein.":"The primary call to action could be more obvious and more consistent."
      },
      "Lead capture":{
        title:deCopy?"Lead Capture vorhanden":"Lead capture is present",
        healthy:deCopy?"Die Website bietet klare Möglichkeiten zur Kontaktaufnahme oder Conversion.":"The site offers clear ways for visitors to get in touch or convert.",
        opportunity:deCopy?"Die Kontakt- oder Lead-Capture-Möglichkeiten könnten prominenter sein.":"Lead capture could be made more prominent or easier to use."
      },
      "Analytics":{
        title:deCopy?"Tracking vorhanden":"Tracking is in place",
        healthy:deCopy?"Messung scheint eingerichtet zu sein und unterstützt datenbasierte Optimierung.":"Measurement appears to be set up, which supports data-driven optimisation.",
        opportunity:deCopy?"Tracking sollte ergänzt werden, damit wichtige Nutzeraktionen messbar werden.":"Tracking should be added so important user actions can be measured."
      },
      "Structured data":{
        title:deCopy?"Strukturierte Daten":"Structured data",
        healthy:deCopy?"Strukturierte Daten sind vorhanden und können die Suchsichtbarkeit unterstützen.":"Structured data appears to be present and can support search visibility.",
        opportunity:deCopy?"Strukturierte Daten scheinen zu fehlen und sind eine klare technische SEO-Chance.":"Structured data appears to be missing and is a clear technical SEO opportunity."
      },
      "Mobile viewport":{
        title:deCopy?"Mobil optimiert":"Mobile-ready setup",
        healthy:deCopy?"Die Website ist technisch für mobile Geräte vorbereitet.":"The site appears technically prepared for mobile devices.",
        opportunity:deCopy?"Die mobile Basis sollte verbessert werden, um die Nutzung auf kleinen Geräten zu stärken.":"Mobile readiness should be improved for a smoother experience on smaller devices."
      },
      "Content depth":{
        title:deCopy?"Ausreichende Inhaltstiefe":"Enough content depth",
        healthy:deCopy?"Die analysierten Seiten enthalten genügend Substanz für eine aussagekräftige Bewertung.":"The sampled pages contain enough substantive content for a meaningful assessment.",
        opportunity:deCopy?"Die Website ist sehr dünn; mehr fokussierte Inhalte würden Nutzern und Suchmaschinen mehr Kontext geben.":"The site is very thin; more focused content would give users and search engines more context."
      }
    };
    const entry=map[label] || {
      title:label,
      healthy:deCopy?"Dieser Bereich wirkt im aktuellen Scan solide.":"This area looks healthy in the current scan.",
      opportunity:deCopy?"Dieser Bereich bietet eine potenzielle Verbesserungsmöglichkeit.":"This area looks like a potential improvement opportunity."
    };
    return {title:entry.title,description:item.passed?entry.healthy:entry.opportunity,status:item.passed?c.healthy:c.opportunities};
  }

  function renderDiagnostics(items){
    const healthyEl=root.querySelector("[data-diagnostics-healthy]");
    const opportunityEl=root.querySelector("[data-diagnostics-opportunities]");
    const healthyCount=root.querySelector("[data-diagnosis-healthy-count]");
    const opportunityCount=root.querySelector("[data-diagnosis-opportunity-count]");
    const summary=root.querySelector("[data-diagnosis-summary]");
    clear(healthyEl); clear(opportunityEl);
    if(!items?.length){
      healthyEl?.appendChild(makeEmpty());
      opportunityEl?.appendChild(makeEmpty());
      if(healthyCount) healthyCount.textContent="0";
      if(opportunityCount) opportunityCount.textContent="0";
      if(summary) summary.textContent=c.empty;
      return;
    }
    const healthy=[];
    const opportunities=[];
    items.forEach(item=>{
      const present=diagnosisCopy(item);
      const card=document.createElement("article");
      card.className=`diagnosis-card ${item.passed?"healthy":"opportunity"}`;
      const top=document.createElement("div"); top.className="diagnosis-card-top";
      const title=document.createElement("strong"); title.textContent=present.title;
      const badge=document.createElement("span"); badge.className="status-pill"; badge.textContent=present.status;
      const p=document.createElement("p"); p.textContent=present.description;
      top.append(title,badge); card.append(top,p);
      if(item.passed) card.classList.add("compact");
      (item.passed?healthy:opportunities).push(card);
    });
    if(!healthy.length) healthyEl?.appendChild(makeEmpty()); else healthy.slice(0,4).forEach(card=>healthyEl?.appendChild(card));
    if(!opportunities.length) opportunityEl?.appendChild(makeEmpty()); else opportunities.forEach(card=>opportunityEl?.appendChild(card));
    if(healthyCount) healthyCount.textContent=String(healthy.length);
    if(opportunityCount) opportunityCount.textContent=String(opportunities.length);
    if(summary) summary.textContent=opportunities.length?c.diagnosisImprove:c.diagnosisGood;
  }

  function sourceItem(item){
    const article=document.createElement("article");
    const top=document.createElement("div"); top.className="source-top";
    const strong=document.createElement("strong"); strong.textContent=item.title || item.name || "Signal";
    const domain=document.createElement("span");
    const url=item.url || item.source;
    if(url){ try{domain.textContent=new URL(url).hostname.replace(/^www\./,"")}catch{} }
    top.append(strong,domain); article.appendChild(top);
    const body=text(item.body || item.snippet || item.context);
    if(body){ const p=document.createElement("p"); p.textContent=body.slice(0,240); article.appendChild(p); }
    if(url){
      const a=document.createElement("a"); a.href=url; a.target="_blank"; a.rel="noopener noreferrer"; a.textContent=c.source+" ↗";
      a.addEventListener("click",()=>track("market_scan_source_click",{source_url:url}));
      article.appendChild(a);
    }
    return article;
  }
  function renderSources(selector,items,limit=12){
    const el=root.querySelector(selector); clear(el);
    if(!items?.length){ el.appendChild(makeEmpty()); return; }
    items.slice(0,limit).forEach(item=>el.appendChild(sourceItem(item)));
  }
  function renderCompetitors(items){
    const el=root.querySelector("[data-competitors]"); clear(el);
    if(!items?.length){ el.appendChild(makeEmpty()); return; }
    items.slice(0,12).forEach(item=>{
      const a=document.createElement("a"); a.className="competitor-card"; a.href=item.url; a.target="_blank"; a.rel="noopener noreferrer";
      const strong=document.createElement("strong"); strong.textContent=item.name || item.title;
      const p=document.createElement("p"); p.textContent=text(item.context || item.snippet).slice(0,180);
      a.append(strong,p); el.appendChild(a);
    });
  }
  function renderAngles(items){
    const el=root.querySelector("[data-ad-angles]"); clear(el);
    if(!items?.length){ el.appendChild(makeEmpty()); return; }
    items.forEach((item,i)=>{
      const article=document.createElement("article");
      const n=document.createElement("span"); n.textContent=String(i+1).padStart(2,"0");
      const p=document.createElement("p"); p.textContent=item;
      article.append(n,p); el.appendChild(article);
    });
  }

  function render(data){
    latestScan=data;
    const report=data.report || {};
    root.querySelector("[data-brand]").textContent=data.brand || report.brand || "Market scan";
    root.querySelector("[data-scanned-url]").textContent=data.scannedUrl || report.scannedUrl || "";
    root.querySelector("[data-elapsed]").textContent=Math.max(.1,(data.elapsedMs||report.elapsedMs||0)/1000).toFixed(1);
    root.querySelector("[data-score]").textContent=String(data.website?.opportunityScore ?? report.website?.opportunityScore ?? "—");
    const summary=data.summary||report.summary||{};
    const executive=report.executive || {};
    const profile=report.marketProfile || {};
    const setText=(selector,value)=>{const el=root.querySelector(selector); if(el) el.textContent=text(value);};
    setText("[data-exec-headline]", executive.headline || (locale==="de"?"Wir haben die wichtigsten Chancen priorisiert.":"We prioritised the clearest opportunities."));
    setText("[data-exec-market-note]", executive.marketNote || "");
    setText("[data-exec-positioning]", executive.positioning || profile.positioning || (locale==="de"?"Keine klare Positionierung erkannt":"No clear positioning detected"));
    setText("[data-exec-action]", executive.topAction || report.priorityActions?.[0]?.title || "");
    setText("[data-exec-site-type]", locale==="de"?`Seitentyp: ${profile.siteType || "—"}`:`Site type: ${profile.siteType || "—"}`);
    setText("[data-exec-confidence]", locale==="de"?`Positionierungs-Sicherheit: ${profile.marketConfidence || "—"}`:`Positioning confidence: ${profile.marketConfidence || "—"}`);

    const externalSignalCount=(summary.buyerSignals||0)+(summary.redditDiscussions||0)+(summary.reviewMentions||0)+(summary.competitorCandidates||0);
    setText("[data-relevant-signal-count]", externalSignalCount);
    setText("[data-signal-quality-note]", profile.marketConfidence==="high"
      ? (locale==="de"?"Die externen Signale passen gut zur erkannten Positionierung.":"External findings closely match the positioning detected on the site.")
      : (locale==="de"?"Wir zeigen nur Signale, die ausreichend gut zur Website passen.":"We only show external findings that match the website closely enough."));

    const qualityNote=root.querySelector("[data-market-quality-note]");
    const lowConfidence=profile.marketConfidence==="low" || profile.siteType==="personal";
    root.querySelectorAll("[data-market-section]").forEach(section=>section.hidden=lowConfidence);
    if(qualityNote){
      qualityNote.hidden=!lowConfidence;
      setText("[data-market-quality-title]", locale==="de"?"Externe Marktdaten bewusst begrenzt":"External market data intentionally limited");
      setText("[data-market-quality-copy]", locale==="de"
        ?"Die Website wirkt primär wie ein persönliches oder informatives Profil. Deshalb zeigen wir nur die Website-Analyse und belastbare Empfehlungen, statt schwache Markt-, Review- oder Wettbewerberdaten hinzuzufügen."
        :"This site reads primarily as a personal or informational profile. We therefore show the website analysis and defensible recommendations, rather than padding the report with weak market, review or competitor data.");
    }

    renderPriorities(report.priorityActions || data.priorityActions || []);
    renderDiagnostics(report.website?.diagnostics || []);
    const painCount=root.querySelector("[data-count-pains]"); if(painCount) painCount.textContent=report.painPoints?.length?String(report.painPoints.length):"";
    renderSources("[data-buyer-signals]",report.buyerSignals || [],3);
    renderSources("[data-pain-points]",report.painPoints || [],3);
    renderSources("[data-reddit]",report.redditDiscussions || [],3);
    renderSources("[data-reviews]",report.reviewMentions || [],3);
    renderCompetitors((report.competitorCandidates || []).slice(0,6));
    renderSources("[data-content-opportunities]",report.contentOpportunities || [],4);
    renderAngles((report.adAngles || []).slice(0,5));
  }

  function startLoadingProgress(domain){
    root.querySelector("[data-loading-domain]").textContent=domain;
    const bar=root.querySelector("[data-loading-bar]"); let pct=12; bar.style.width=pct+"%";
    loadingTimer=window.setInterval(()=>{ pct=Math.min(90,pct+Math.max(2,(92-pct)*.1)); bar.style.width=pct+"%"; },450);
  }
  function stopLoadingProgress(){
    if(loadingTimer) window.clearInterval(loadingTimer);
    loadingTimer=null; const bar=root.querySelector("[data-loading-bar]"); if(bar) bar.style.width="100%";
  }
  function unlockReport(){
    if(reportTimer) window.clearInterval(reportTimer);
    const shell=root.querySelector("[data-report-shell]");
    shell?.classList.remove("is-locked");
    root.querySelector("[data-report-lock]").hidden=true;
    root.querySelector("[data-report-timer]").hidden=false;
    root.querySelector("[data-countdown]").textContent="1:30";
  }
  function startPreviewTimer(){
    unlockReport();
    let remaining=PREVIEW_SECONDS;
    const countdown=root.querySelector("[data-countdown]");
    const update=()=>{
      const m=Math.floor(remaining/60); const s=String(remaining%60).padStart(2,"0");
      countdown.textContent=`${m}:${s}`;
      if(remaining<=0){
        window.clearInterval(reportTimer); reportTimer=null;
        root.querySelector("[data-report-shell]")?.classList.add("is-locked");
        root.querySelector("[data-report-lock]").hidden=false;
        root.querySelector("[data-report-timer]").hidden=true;
        track("market_scan_report_locked",{website_domain:(()=>{try{return new URL(latestScan?.scannedUrl||"").hostname}catch{return ""}})()});
        return;
      }
      remaining-=1;
    };
    update(); reportTimer=window.setInterval(update,1000);
  }

  form?.addEventListener("submit", async (event)=>{
    event.preventDefault(); status.textContent="";
    const url=normalize(new FormData(form).get("url"));
    if(!url){ status.textContent=c.error; return; }
    const button=form.querySelector('button[type="submit"]'); button?.setAttribute("disabled","true");
    unlockReport(); formView.hidden=true; results.hidden=true; loading.hidden=false; startLoadingProgress(url.hostname);
    track("market_scan_start",{website_domain:url.hostname});
    try{
      const response=await fetch(`${apiBase}/api/scan`,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({url:url.toString()})});
      const data=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(data.detail || data.error || c.error);
      render(data); stopLoadingProgress();
      window.setTimeout(()=>{
        loading.hidden=true; results.hidden=false; startPreviewTimer();
        results.scrollIntoView({behavior:"smooth",block:"start"});
      },220);
      track("market_scan_complete",{website_domain:url.hostname,...data.summary,opportunity_score:data.website?.opportunityScore,elapsed_ms:data.elapsedMs});
    }catch(error){
      stopLoadingProgress(); loading.hidden=true; formView.hidden=false;
      status.textContent=error?.message || c.error;
      track("market_scan_error",{website_domain:url.hostname,error_message:String(error?.message||"unknown")});
    }finally{ button?.removeAttribute("disabled"); }
  });

  const newsletterForm=root.querySelector("[data-market-newsletter]");
  newsletterForm?.addEventListener("submit",async(event)=>{
    event.preventDefault();
    const fd=new FormData(newsletterForm);
    const email=text(fd.get("email")); const honeypot=text(fd.get("website"));
    const accepted=text(fd.get("privacyPolicyAccepted"))==="yes";
    const msg=newsletterForm.querySelector("[data-newsletter-status]");
    const button=newsletterForm.querySelector('button[type="submit"]');
    if(honeypot){ newsletterForm.reset(); if(msg) msg.textContent=c.subscribed; return; }
    if(!newsletterForm.checkValidity() || !email || !accepted){ newsletterForm.reportValidity(); if(msg) msg.textContent=c.subscribeValidation; return; }

    const attribution=window.websiteliGetAttribution?.() || {};
    const scannedUrl=latestScan?.scannedUrl || "";
    const payload={
      type:"newsletter",email,campaign:"market-scan-report",sourceUrl:window.location.href,
      language:document.documentElement.lang || locale,website:honeypot,
      metadata:{
        language:document.documentElement.lang || locale,
        country:window.websiteliPricing?.country || "",currency:window.websiteliPricing?.currency || "",market:window.websiteliPricing?.pricingMarket || "",
        pageUrl:window.location.href,referrer:document.referrer,userAgent:navigator.userAgent,campaign:"market-scan-report",
        scannedUrl,scannedDomain:(()=>{try{return new URL(scannedUrl).hostname}catch{return ""}})(),
        opportunityScore:latestScan?.website?.opportunityScore ?? "",buyerSignals:latestScan?.summary?.buyerSignals ?? 0,
        competitorCandidates:latestScan?.summary?.competitorCandidates ?? 0,priorityActions:latestScan?.summary?.priorityActions ?? 0,
        utm_source:attribution.utm_source||"",utm_medium:attribution.utm_medium||"",utm_campaign:attribution.utm_campaign||"",
        utm_term:attribution.utm_term||"",utm_content:attribution.utm_content||"",utm_id:attribution.utm_id||"",
        gclid:attribution.gclid||"",gbraid:attribution.gbraid||"",wbraid:attribution.wbraid||"",fbclid:attribution.fbclid||"",msclkid:attribution.msclkid||"",
        landingPage:attribution.landingPage||"",firstSeenAt:attribution.firstSeenAt||"",first_utm_source:attribution.first_utm_source||"",
        first_utm_medium:attribution.first_utm_medium||"",first_utm_campaign:attribution.first_utm_campaign||"",
        first_gclid:attribution.first_gclid||"",first_fbclid:attribution.first_fbclid||"",
        privacyPolicyAccepted:true,privacyPolicyVersion,privacyPolicyUrl:`${window.location.origin}/privacy/`,timestamp:new Date().toISOString()
      }
    };
    button?.setAttribute("disabled","true"); if(msg) msg.textContent=c.sending;
    try{
      const emailResponse=await fetch(`${apiBase}/api/email-report`,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({scanId:latestScan?.scanId,email,consent:true})});
      const emailResult=await emailResponse.json().catch(()=>({}));
      if(!emailResponse.ok) throw new Error(emailResult.detail || emailResult.error || c.subscribeError);
      await fetch(newsletterEndpoint,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(payload)});
      newsletterForm.reset(); if(msg) msg.textContent=c.subscribed;
      try{localStorage.setItem("websiteli_market_scan_subscribed","true")}catch{}
      window.trackWebsiteliEvent?.("newsletter_subscribe",{event_category:"lead",event_label:"Market Scan report",campaign:"market-scan-report",locale,source_path:window.location.pathname,privacy_policy_accepted:"yes"});
      track("market_scan_report_emailed",{website_domain:payload.metadata.scannedDomain,opportunity_score:payload.metadata.opportunityScore});
    }catch(error){
      if(msg) msg.textContent=error?.message || c.subscribeError;
      track("market_scan_email_error",{error_message:String(error?.message||"unknown")});
    }finally{button?.removeAttribute("disabled");}
  });

  root.querySelector("[data-again]")?.addEventListener("click",()=>{
    if(reportTimer) window.clearInterval(reportTimer); reportTimer=null;
    unlockReport(); results.hidden=true; formView.hidden=false; form?.reset(); status.textContent=""; latestScan=null;
    window.scrollTo({top:0,behavior:"smooth"}); track("market_scan_again");
  });
  root.querySelector("[data-book]")?.addEventListener("click",()=>track("market_scan_booking_click",{
    website_domain:(()=>{try{return new URL(latestScan?.scannedUrl||"").hostname}catch{return ""}})(),
    opportunity_score:latestScan?.website?.opportunityScore ?? ""
  }));
})();
</script>

<style>
  [hidden]{display:none!important}
  .market-scan{padding:0 0 92px}
  .scan-hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:clamp(36px,6vw,84px);align-items:center;min-height:min(820px,92vh);padding-top:128px;padding-bottom:64px}
  .scan-hero-copy{max-width:760px}.eyebrow{margin:0 0 12px;color:var(--brand);font-size:.78rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .scan-hero h1,.result-header h1{margin:0;letter-spacing:-.05em;line-height:.96}.scan-hero h1{font-size:clamp(3rem,6.3vw,5.7rem)}
  .scan-intro{max-width:690px;margin:22px 0 30px;color:var(--muted);font-size:clamp(1.05rem,1.7vw,1.24rem);line-height:1.62}
  .scan-form{max-width:760px}.scan-url{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center;padding:7px;border:1px solid var(--line);border-radius:10px;background:var(--surface);box-shadow:var(--shadow)}
  .url-prefix{display:grid;width:42px;height:42px;place-items:center;color:var(--brand);font-weight:900}.scan-url input{min-width:0;border:0;outline:0;padding:14px 8px;background:transparent;color:var(--ink);font-size:1rem}
  .button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;gap:10px;border:1px solid var(--brand);border-radius:8px;padding:0 18px;background:var(--brand);color:white;font-weight:900;cursor:pointer;box-shadow:0 14px 30px color-mix(in srgb,var(--brand) 18%,transparent)}
  .button:hover{background:var(--brand-strong);border-color:var(--brand-strong)}.button:disabled{opacity:.58;cursor:wait}
  .status{min-height:22px;margin:10px 0 0;color:var(--brand);font-size:.86rem}.scan-trust{margin:8px 0 0;color:var(--muted);font-size:.85rem}.scan-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .scan-tags span{display:inline-flex;min-height:34px;align-items:center;border:1px solid var(--line);border-radius:999px;padding:0 11px;background:var(--surface);color:var(--muted);font-size:.78rem;font-weight:800}
  .market-map-visual{position:relative;overflow:hidden;min-height:430px;padding:24px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,color-mix(in srgb,var(--surface) 97%,transparent),color-mix(in srgb,var(--surface-soft) 92%,var(--brand) 8%));box-shadow:var(--shadow)}
  .market-map-visual:before{position:absolute;inset:auto -80px -90px auto;width:230px;height:230px;border-radius:50%;background:color-mix(in srgb,var(--brand) 10%,transparent);content:"";filter:blur(2px)}
  .market-map-top{position:relative;z-index:3;display:flex;justify-content:space-between;gap:18px;align-items:center;color:var(--muted);font-size:.77rem;font-weight:850}
  .market-map-live{color:var(--brand)}
  .market-map-stage{position:relative;height:320px;margin-top:14px}
  .market-map-lines{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .market-map-lines path{fill:none;stroke:color-mix(in srgb,var(--brand) 23%,var(--line));stroke-width:1.4;stroke-dasharray:5 7}
  .map-node{position:absolute;z-index:2;display:flex;align-items:center;gap:10px;min-width:140px;padding:11px 12px;border:1px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--surface) 94%,transparent);box-shadow:0 10px 28px rgba(26,32,42,.08);backdrop-filter:blur(8px)}
  .map-node strong{display:block;font-size:.78rem;line-height:1.25}.map-node small{display:block;margin-top:2px;color:var(--muted);font-size:.64rem;line-height:1.3}
  .node-dot{width:9px;height:9px;flex:0 0 auto;border-radius:50%;background:var(--brand);box-shadow:0 0 0 5px color-mix(in srgb,var(--brand) 10%,transparent)}
  .center-node{left:50%;top:50%;min-width:176px;transform:translate(-50%,-50%);padding:15px 16px;border-color:color-mix(in srgb,var(--brand) 35%,var(--line));background:var(--surface);box-shadow:0 16px 38px color-mix(in srgb,var(--brand) 11%,transparent)}
  .node-icon{display:grid;width:30px;height:30px;flex:0 0 auto;place-items:center;border-radius:9px;background:var(--brand);color:white;font-weight:900}
  .node-top{left:50%;top:0;transform:translateX(-50%)}.node-bottom{left:50%;bottom:0;transform:translateX(-50%)}
  .node-left-top{left:0;top:52px}.node-right-top{right:0;top:50px}.node-left-bottom{left:0;bottom:48px}.node-right-bottom{right:0;bottom:46px}
  .market-map-footer{position:relative;z-index:3;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px;padding-top:14px;border-top:1px solid var(--line)}
  .market-map-footer span{display:flex;gap:6px;align-items:center;color:var(--muted);font-size:.68rem;font-weight:800}.market-map-footer b{color:var(--brand);font-size:.65rem}
  .scan-loading{padding:150px 0 90px}.loading-card{display:grid;justify-items:center;max-width:760px;margin:auto;padding:48px;border:1px solid var(--line);border-radius:10px;background:var(--surface);box-shadow:var(--shadow);text-align:center}
  .spinner{width:46px;height:46px;margin-bottom:24px;border:3px solid var(--line);border-top-color:var(--brand);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.loading-card h2{margin:0 0 8px}.loading-card>p:not(.eyebrow){margin:0;color:var(--muted)}
  .loading-steps{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:28px}.loading-steps span{border:1px solid var(--line);border-radius:999px;padding:8px 11px;color:var(--muted);font-size:.78rem}.loading-steps b{color:var(--brand)}
