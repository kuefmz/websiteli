  .lock-card form{display:grid;gap:10px;text-align:left}.email-field{display:grid;gap:6px}.email-field>span{color:var(--muted);font-size:.76rem;font-weight:800}.email-field input{width:100%;border:1px solid var(--line);border-radius:8px;padding:13px 14px;background:var(--surface-soft);color:var(--ink);outline:0}.email-field input:focus{border-color:var(--brand)}.consent{display:flex;gap:9px;align-items:flex-start;color:var(--muted);font-size:.76rem;line-height:1.45}.consent input{margin-top:3px}.consent a{color:var(--brand-strong);text-decoration:underline}.newsletter-status{min-height:18px;margin:0;color:var(--muted);font-size:.78rem}.hp{position:absolute!important;left:-9999px!important;opacity:0!important}
