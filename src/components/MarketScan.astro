  .scan-loading{padding:150px 0 90px}.loading-card{display:grid;justify-items:center;max-width:760px;margin:auto;padding:48px;border:1px solid var(--line);border-radius:10px;background:var(--surface);box-shadow:var(--shadow);text-align:center}
  .spinner{width:46px;height:46px;margin-bottom:24px;border:3px solid var(--line);border-top-color:var(--brand);border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.loading-card h2{margin:0 0 8px}.loading-card>p:not(.eyebrow){margin:0;color:var(--muted)}
  .loading-steps{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:28px}.loading-steps span{border:1px solid var(--line);border-radius:999px;padding:8px 11px;color:var(--muted);font-size:.78rem}.loading-steps b{color:var(--brand)}
  .progress-track{width:min(100%,540px);height:5px;margin-top:28px;overflow:hidden;border-radius:99px;background:var(--line)}.progress-track span{display:block;width:10%;height:100%;background:var(--brand);transition:width .4s ease}
  .scan-results{padding-top:126px}.result-header{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:28px}.result-header h1{font-size:clamp(2.6rem,5vw,4.7rem)}.scanned-url{margin:12px 0 0;color:var(--muted);overflow-wrap:anywhere}
  .scan-time{display:grid;gap:3px;text-align:right}.scan-time>span{color:var(--muted);font-size:.75rem;text-transform:uppercase;font-weight:850}.scan-time strong{font-size:1.55rem}
  .overview-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:16px}.score-card,.priority-card,.metric-grid article,.report-section,.report-heading,.scan-cta{border:1px solid var(--line);border-radius:10px;background:color-mix(in srgb,var(--surface) 96%,transparent);box-shadow:0 16px 48px rgba(26,32,42,.07)}
