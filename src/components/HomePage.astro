---
import FAQ from "./FAQ.astro";
import { pricing } from "../config/pricing";
import { getPackageLabels } from "../config/packageLabels";
import { getConversionHomeContent } from "../content/home";
import { getFeaturedPortfolioProjects, realPortfolioProjects } from "../content/portfolio";
import type { LocaleCode } from "../content/locales";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const home = getConversionHomeContent(locale);
const featuredProjects = getFeaturedPortfolioProjects(5);
const heroProjects = realPortfolioProjects;
const heroProjectData = heroProjects.map((project) => ({
  slug: project.slug,
  name: displayProjectName(project.name),
  category: project.category,
  url: project.url ?? "",
  verifiedUrl: project.verifiedUrl,
}));
const contactHref = `/${locale}/contact/?package=digitalAudit&project=website-review&intent=website_review`;
const portfolioHref = `/${locale}/portfolio/`;
const workHref = "#work";
const pricingHref = `/${locale}/services-pricing/#pricing`;
const partnersHref = `/${locale}/partners/`;
const swissPricing = pricing.CH;
const packageLabels = getPackageLabels(locale);

function localizedHref(href?: string) {
  if (!href) return undefined;
  if (href.startsWith("http")) return href;
  return `/${locale}${href}`;
}

function serviceHref(slug?: string) {
  return slug ? `/${locale}/services/${slug}/` : `/${locale}/services-pricing/`;
}

function formatChf(amount: number) {
  return `from ${swissPricing.symbol} ${new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(amount)}`;
}

function shortProjectName(name: string) {
  if (name === "Semantic Web Science Association") return "SWSA";
  if (name === "Jenifer Ciuciu-Kiss") return "Personal Website";
  return name;
}

function displayProjectName(name: string) {
  if (name === "Jenifer Ciuciu-Kiss") return "Personal Website";
  return name;
}

function displayProjectImageAlt(project: { name: string; imageAlt?: string }) {
  if (project.name === "Jenifer Ciuciu-Kiss") {
    return "Personal website homepage screenshot with professional positioning and project links.";
  }

  return project.imageAlt ?? `${project.name} website screenshot`;
}
---

<main class="conversion-home">
  <section class="conversion-hero section-shell" id="home">
    <div class="conversion-hero-copy">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.title}</h1>
      <p class="hero-text">{home.hero.text}</p>
      <p class="hero-secondary">{home.hero.secondary}</p>
      <p class="hero-price-signal">{home.hero.priceSignal}</p>
      <div class="hero-actions">
        <a class="button primary" href={workHref} data-track-event="portfolio_cta_click" data-track-label="Hero see work">{home.hero.primaryCta}</a>
        <a class="button secondary" href={contactHref} data-track-event="website_review_cta_click" data-track-label="Hero website review">{home.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero-showcase" aria-label={home.portfolio.title} data-hero-showcase data-projects={JSON.stringify(heroProjectData)}>
      <div class="portfolio-hero-frame">
        {heroProjects.map((project, index) => (
          <article
            class:list={["hero-project-slide", index === 0 && "is-active", !project.image && "is-pending"]}
            id={`hero-project-${project.slug}`}
            data-hero-slide
            data-project-index={String(index)}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            {project.image ? (
              <img
                src={project.image}
                alt={displayProjectImageAlt(project)}
                width="1200"
                height="760"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            ) : (
              <div class="screenshot-pending">
                <span>{project.category}</span>
                <strong>{displayProjectName(project.name)}</strong>
                <small>{project.expectedImage ? `Expected asset: ${project.expectedImage}` : home.portfolio.linkPending}</small>
              </div>
            )}
          </article>
        ))}
      </div>
      <div class="hero-project-summary">
        <div>
          <strong data-hero-project-name>{heroProjects[0]?.name}</strong>
          <span data-hero-project-category>{heroProjects[0]?.category}</span>
        </div>
        <a
          class="text-link"
          href={heroProjects[0]?.url}
          target="_blank"
          rel="noopener"
          data-hero-project-link
          data-track-event="portfolio_project_click"
          data-track-label={heroProjects[0]?.slug}
        >
          {home.portfolio.viewWebsite} →
        </a>
        <span class="hero-project-status" data-hero-project-status hidden>{home.portfolio.linkPending}</span>
      </div>
      <div class="hero-project-selector" role="tablist" aria-label="Featured project screenshots">
        {heroProjects.map((project, index) => (
          <button
            class:list={["hero-project-control", index === 0 && "is-active"]}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`hero-project-${project.slug}`}
            data-hero-control
            data-project-index={String(index)}
          >
            <span>{shortProjectName(project.name)}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell section-block compact-top home-work-section" id="work">
    <div class="section-heading">
      <p class="eyebrow">{home.portfolio.eyebrow}</p>
      <h2>{home.portfolio.title}</h2>
      <p>{home.portfolio.text}</p>
    </div>
    <div class="work-card-grid">
      {featuredProjects.map((project) => (
        <article class:list={["work-card", project.featured && "featured-work"]}>
          <div class="work-preview">
            {project.image ? (
              <img src={project.image} alt={displayProjectImageAlt(project)} width="1200" height="760" loading="lazy" decoding="async" />
            ) : (
              <div class="screenshot-pending compact">
                <span>{project.category}</span>
                <strong>{displayProjectName(project.name)}</strong>
                <small>{project.expectedImage ? `Expected asset: ${project.expectedImage}` : home.portfolio.linkPending}</small>
              </div>
            )}
          </div>
          <div class="work-card-body">
            <p class="project-kicker">{project.category}</p>
            <h3>{displayProjectName(project.name)}</h3>
            <p>{project.description}</p>
            {project.verifiedUrl && project.url ? (
              <a class="text-link" href={project.url} target="_blank" rel="noopener" data-track-event="portfolio_project_click" data-track-label={project.slug}>
                {home.portfolio.viewWebsite} →
              </a>
            ) : (
              <span class="text-link muted-link" title={project.verificationNote}>{home.portfolio.linkPending}</span>
            )}
          </div>
        </article>
      ))}
    </div>
    <div class="centered-actions section-cta">
      <a class="button secondary" href={portfolioHref} data-track-event="portfolio_cta_click" data-track-label="Homepage portfolio section">{home.portfolio.viewAll}</a>
    </div>
  </section>

  <section class="trust-strip" aria-label="Websiteli trust points">
    <div class="section-shell trust-strip-inner">
      {home.trust.map((item) => <span>{item}</span>)}
    </div>
  </section>

  <section class="section-shell section-block" id="services">
    <div class="section-heading centered">
      <p class="eyebrow">{home.solutions.eyebrow}</p>
      <h2>{home.solutions.title}</h2>
      <p>{home.solutions.text}</p>
    </div>
    <div class="solution-card-grid">
      {home.solutions.cards.map((card, index) => (
        <article class="solution-card-minimal">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <a href={serviceHref(card.href)} data-track-event="service_card_click" data-track-label={card.href ?? card.title}>{home.solutions.learnMore}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="pricing-snapshot-band" id="pricing">
    <div class="section-shell pricing-snapshot-inner">
      <div class="section-heading">
        <p class="eyebrow">{home.pricing.eyebrow}</p>
        <h2>{home.pricing.title}</h2>
        <p>{home.pricing.text}</p>
      </div>
      <div class="pricing-snapshot-grid">
        {Object.entries(home.pricing.plans).map(([packageKey, plan]) => {
          const amount = swissPricing.packages[packageKey as keyof typeof swissPricing.packages]?.from;
          const packageLabel = packageLabels[packageKey as keyof typeof packageLabels] ?? plan.title;
          return (
            <article class="pricing-snapshot-card" data-package-card={packageKey}>
              <h3>{packageLabel}</h3>
              <p class="plan-price" data-package-price={packageKey}>{typeof amount === "number" ? formatChf(amount) : home.pricing.customQuote}</p>
              <p>{plan.text}</p>
            </article>
          );
        })}
        <article class="pricing-snapshot-card maintenance-card">
          <h3>{packageLabels.websiteMaintenance}</h3>
          <p class="plan-price">{home.pricing.customQuote}</p>
          <p>{home.pricing.maintenance.text}</p>
        </article>
      </div>
      <a class="button primary" href={pricingHref} data-track-event="pricing_cta_click" data-track-label="Homepage compare packages">{home.pricing.compare}</a>
    </div>
  </section>

  <section class="section-shell section-block" id="process">
    <div class="section-heading">
      <p class="eyebrow">{home.process.eyebrow}</p>
      <h2>{home.process.title}</h2>
    </div>
    <div class="process-grid">
      {home.process.steps.map((step, index) => (
        <article class="process-step">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="founder-band">
    <div class="section-shell founder-inner">
      <div>
        <p class="eyebrow">{home.founder.eyebrow}</p>
        <h2>{home.founder.title}</h2>
        <p>{home.founder.text}</p>
      </div>
      <div class="founder-proof">
        <span>CH</span>
        <strong>Websites, software engineering and practical business systems.</strong>
      </div>
    </div>
  </section>

  <section class="section-shell section-block compact-top">
    <div class="section-heading">
      <p class="eyebrow">{home.outcomes.eyebrow}</p>
      <h2>{home.outcomes.title}</h2>
    </div>
    <div class="outcome-grid">
      {home.outcomes.items.map((item) => (
        <article class="outcome-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell section-block compact-top" id="industries">
    <div class="industry-link-panel">
      <div>
        <p class="eyebrow">{home.industries.eyebrow}</p>
        <h2>{home.industries.title}</h2>
        <p>{home.industries.text}</p>
      </div>
      <div class="industry-link-list">
        {home.industries.links.map((link) => (
          <a href={localizedHref(link.href)}>{link.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="partner-teaser-band">
    <div class="section-shell partner-teaser-inner">
      <div>
        <p class="eyebrow">{home.partners.eyebrow}</p>
        <h2>{home.partners.title}</h2>
        <p>{home.partners.text}</p>
      </div>
      <a class="button secondary" href={partnersHref} data-track-event="partner_click" data-track-label="Homepage partner teaser">{home.partners.cta} →</a>
    </div>
  </section>

  <section class="section-shell section-block compact-top faq-section">
    <div class="section-heading">
      <p class="eyebrow">{home.faq.eyebrow}</p>
      <h2>{home.faq.title}</h2>
    </div>
    <div class="faq-list">
      {home.faq.items.map((item) => <FAQ {...item} />)}
    </div>
  </section>

  <section class="section-shell final-review-cta" id="contact">
    <div>
      <p class="eyebrow">{home.finalCta.eyebrow}</p>
      <h2>{home.finalCta.title}</h2>
      <p>{home.finalCta.text}</p>
    </div>
    <a class="button primary" href={contactHref} data-track-event="website_review_cta_click" data-track-label="Homepage final website review">{home.finalCta.cta}</a>
  </section>
</main>

<script>
  window.trackWebsiteliEvent?.("homepage_view", {
    event_category: "page",
    event_label: document.documentElement.lang || "en",
    page_path: window.location.pathname,
  });

  const pricingSection = document.querySelector("#pricing");
  if (pricingSection && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        window.trackWebsiteliEvent?.("pricing_view", {
          event_category: "engagement",
          event_label: "Homepage pricing",
          page_path: window.location.pathname,
        });
        observer.disconnect();
      },
      { threshold: 0.35 },
    );
    observer.observe(pricingSection);
  }

  const heroShowcase = document.querySelector("[data-hero-showcase]");
  if (heroShowcase instanceof HTMLElement) {
    const projects = JSON.parse(heroShowcase.dataset.projects || "[]");
    const slides = Array.from(heroShowcase.querySelectorAll("[data-hero-slide]"));
    const controls = Array.from(heroShowcase.querySelectorAll("[data-hero-control]"));
    const nameEl = heroShowcase.querySelector("[data-hero-project-name]");
    const categoryEl = heroShowcase.querySelector("[data-hero-project-category]");
    const linkEl = heroShowcase.querySelector("[data-hero-project-link]");
    const statusEl = heroShowcase.querySelector("[data-hero-project-status]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let activeIndex = 0;
    let rotationId;

    function stopRotation() {
      if (!rotationId) return;
      window.clearInterval(rotationId);
      rotationId = undefined;
    }

    function updateSummary(project) {
      if (!project) return;
      if (nameEl) nameEl.textContent = project.name;
      if (categoryEl) categoryEl.textContent = project.category;
      if (linkEl instanceof HTMLAnchorElement) {
        const canLink = Boolean(project.url && project.verifiedUrl);
        linkEl.hidden = !canLink;
        linkEl.href = canLink ? project.url : "#";
        linkEl.dataset.trackLabel = project.slug || project.name;
      }
      if (statusEl instanceof HTMLElement) {
        statusEl.hidden = Boolean(project.url && project.verifiedUrl);
      }
    }

    function setActive(index, options = {}) {
      if (!projects[index]) return;
      activeIndex = index;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
      controls.forEach((control, controlIndex) => {
        const isActive = controlIndex === index;
        control.classList.toggle("is-active", isActive);
        control.setAttribute("aria-selected", isActive ? "true" : "false");
      });
      updateSummary(projects[index]);
      if (options.userInitiated) stopRotation();
    }

    function startRotation() {
      stopRotation();
      if (reducedMotion.matches || projects.length < 2) return;
      rotationId = window.setInterval(() => {
        setActive((activeIndex + 1) % projects.length);
      }, 4600);
    }

    controls.forEach((control, index) => {
      control.addEventListener("click", () => setActive(index, { userInitiated: true }));
      control.addEventListener("pointerenter", () => setActive(index, { userInitiated: true }));
      control.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? controls.length - 1
              : event.key === "ArrowRight"
                ? (index + 1) % controls.length
                : (index - 1 + controls.length) % controls.length;
        setActive(nextIndex, { userInitiated: true });
        controls[nextIndex]?.focus();
      });
    });

    reducedMotion.addEventListener?.("change", startRotation);
    startRotation();
  }
</script>
