---
import FAQ from "./FAQ.astro";
import { getLocalizedPath, type LocaleCode } from "../content/locales";
import { getPartnerPageContent } from "../content/partners";

interface Props {
  locale: string;
}

const { locale = "en" } = Astro.props;
const currentLocale = locale as LocaleCode;
const partnerContent = getPartnerPageContent(currentLocale);
const contactHref = getLocalizedPath(currentLocale, "contact");
const eventPartnerHref = `/${currentLocale}/partners/event-organizers/`;
const becomePartnerHref = `${contactHref}?package=digitalAudit&project=partners&intent=partner_inquiry`;
const discoveryCallHref = `${contactHref}?package=digitalAudit&project=partners&intent=discovery_call`;
const referralHref = `${contactHref}?package=digitalAudit&project=referral&intent=refer_client`;
const referralHeroImage = "/assets/partners/become-a-partner-hero.png";

const pageCopy = {
  en: {
    heroAlt: "Websiteli partner program: refer someone who needs a website and receive CHF 100, with examples of Slap AI, Movere Clinic, Orgelia and Before You Trust.",
    agencyEyebrow: "For agencies & freelancers",
    agencyTitle: "Want more than a one-off referral?",
    agencyText: "Websiteli can also work behind the scenes as your white-label technical partner for websites, automation and AI projects.",
    agencyPrimary: "See partnership models",
    agencySecondary: "Schedule a call",
    referralBadge: "One-off",
    referralTitle: "One-off Referral",
    referralSummary: "Introduce a client to Websiteli. If they become a paying client, you receive a flat CHF 100 — and that's it.",
    referralPoints: ["One simple introduction", "No selling or project work", "Flat CHF 100 after their first project is paid"],
    referralCta: "Refer a client",
  },
  de: {
    heroAlt: "Websiteli Partnerprogramm: Empfehlen Sie jemanden, der eine Website braucht, und erhalten Sie CHF 100. Gezeigt werden Slap AI, Movere Clinic, Orgelia und Before You Trust.",
    agencyEyebrow: "Für Agenturen & Freelancer",
    agencyTitle: "Mehr als eine einmalige Empfehlung?",
    agencyText: "Websiteli kann auch als White-Label-Technikpartner für Websites, Automation und KI-Projekte im Hintergrund arbeiten.",
    agencyPrimary: "Partnerschaftsmodelle ansehen",
    agencySecondary: "Gespräch buchen",
    referralBadge: "Einmalig",
    referralTitle: "Einmalige Empfehlung",
    referralSummary: "Stellen Sie Websiteli einen Kunden vor. Wird daraus ein zahlender Kunde, erhalten Sie einmalig CHF 100 — das ist alles.",
    referralPoints: ["Eine einfache Vorstellung", "Kein Verkauf und keine Projektarbeit", "Einmalig CHF 100 nach Bezahlung des ersten Projekts"],
    referralCta: "Kunden empfehlen",
  },
  fr: {
    heroAlt: "Programme partenaire Websiteli : recommandez une personne ayant besoin d'un site web et recevez CHF 100, avec Slap AI, Movere Clinic, Orgelia et Before You Trust.",
    agencyEyebrow: "Pour agences & freelances",
    agencyTitle: "Vous voulez plus qu'une recommandation ponctuelle ?",
    agencyText: "Websiteli peut aussi travailler en marque blanche comme partenaire technique pour vos sites, automatisations et projets IA.",
    agencyPrimary: "Voir les modèles de partenariat",
    agencySecondary: "Planifier un appel",
    referralBadge: "Ponctuel",
    referralTitle: "Recommandation ponctuelle",
    referralSummary: "Présentez un client à Websiteli. S'il devient client payant, vous recevez un montant fixe de CHF 100 — rien de plus à gérer.",
    referralPoints: ["Une simple mise en relation", "Aucune vente ni gestion de projet", "CHF 100 fixes après le paiement du premier projet"],
    referralCta: "Recommander un client",
  },
  it: {
    heroAlt: "Programma partner Websiteli: segnala qualcuno che ha bisogno di un sito e ricevi CHF 100, con esempi Slap AI, Movere Clinic, Orgelia e Before You Trust.",
    agencyEyebrow: "Per agenzie & freelance",
    agencyTitle: "Vuoi più di un referral una tantum?",
    agencyText: "Websiteli può anche lavorare dietro le quinte come partner tecnico white-label per siti, automazione e progetti AI.",
    agencyPrimary: "Vedi i modelli di partnership",
    agencySecondary: "Prenota una call",
    referralBadge: "Una tantum",
    referralTitle: "Referral una tantum",
    referralSummary: "Presenta un cliente a Websiteli. Se diventa un cliente pagante, ricevi CHF 100 una tantum — e finisce lì.",
    referralPoints: ["Una semplice presentazione", "Nessuna vendita o gestione del progetto", "CHF 100 una tantum dopo il pagamento del primo progetto"],
    referralCta: "Segnala un cliente",
  },
} as const;

const copy = pageCopy[currentLocale as keyof typeof pageCopy] ?? pageCopy.en;
---

<main class="partners-page referral-page">
  <section class="section-shell referral-image-hero" aria-labelledby="partners-title">
    <h1 id="partners-title" class="sr-only">{partnerContent.hero.title}</h1>
    <a
      href={referralHref}
      class="referral-image-link"
      aria-label={copy.referralCta}
      data-track-event="partner_referral_click"
      data-track-label="Referral hero image CHF 100"
    >
      <img
        src={referralHeroImage}
        alt={copy.heroAlt}
        width="1774"
        height="887"
        loading="eager"
        decoding="async"
      />
    </a>
  </section>

  <section class="agency-partner-band" id="agency-partnership">
    <div class="section-shell agency-partner-inner">
      <div>
        <p class="eyebrow">{copy.agencyEyebrow}</p>
        <h2>{copy.agencyTitle}</h2>
        <p>{copy.agencyText}</p>
      </div>
      <div class="button-row">
        <a class="button primary" href="#partnership-models">{copy.agencyPrimary}</a>
        <a class="button secondary" href={discoveryCallHref} data-track-event="partner_cta_click" data-track-label="Partner page agency call">{copy.agencySecondary}</a>
      </div>
    </div>
  </section>

  <section class="section-shell section-block" id="partnership-models">
    <div class="section-heading centered">
      <p class="eyebrow">{partnerContent.sections.models.eyebrow}</p>
      <h2>{partnerContent.sections.models.title}</h2>
      <p>{partnerContent.sections.models.text}</p>
    </div>
    <div class="partners-model-grid">
      <article class="pricing-card partner-model-card referral-model-card">
        <span class="card-badge">{copy.referralBadge}</span>
        <h3>{copy.referralTitle}</h3>
        <p>{copy.referralSummary}</p>
        <ul>
          {copy.referralPoints.map((point) => <li>{point}</li>)}
        </ul>
        <a class="button primary" href={referralHref} data-track-event="partner_referral_click" data-track-label="One-off CHF 100 referral model">{copy.referralCta}</a>
      </article>
      {partnerContent.models.slice(1).map((item) => (
        <article class:list={["pricing-card", "partner-model-card", item.recommended && "recommended", item.featured && "featured"]}>
          {item.badge && <span class="card-badge">{item.badge}</span>}
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <ul>
            {item.points.map((point) => <li>{point}</li>)}
          </ul>
          <a class="button secondary" href={item.featured ? discoveryCallHref : becomePartnerHref} data-track-event="partner_model_click" data-track-label={item.title}>{partnerContent.actions.discussModel}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell event-partner-spotlight compact-partner-spotlight" id="event-organizer-partnership" aria-labelledby="event-partner-spotlight-title">
    <div class="event-partner-spotlight-panel">
      <div>
        <p class="eyebrow">{partnerContent.eventPartnerSpotlight.eyebrow}</p>
        <h2 id="event-partner-spotlight-title">{partnerContent.eventPartnerSpotlight.title}</h2>
        <p>{partnerContent.eventPartnerSpotlight.text}</p>
      </div>
      <a class="button secondary" href={eventPartnerHref} data-track-event="partner_event_page_click" data-track-label="Partner page event partnership">{partnerContent.eventPartnerSpotlight.cta}</a>
    </div>
  </section>

  <section class="section-shell section-block compact-top faq-section" id="faq">
    <div class="section-heading">
      <p class="eyebrow">{partnerContent.sections.faq.eyebrow}</p>
      <h2>{partnerContent.sections.faq.title}</h2>
    </div>
    <div class="faq-list">
      {partnerContent.faqs.slice(0, 4).map((item) => <FAQ {...item} />)}
    </div>
  </section>
</main>

<style>
  .referral-image-hero {
    padding-top: clamp(1.25rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 4vw, 3.5rem);
  }

  .referral-image-link {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(223, 28, 45, 0.16);
    border-radius: clamp(18px, 2vw, 28px);
    background: #fff;
    box-shadow: 0 24px 70px rgba(20, 28, 45, 0.11);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .referral-image-link:hover,
  .referral-image-link:focus-visible {
    transform: translateY(-3px);
    border-color: rgba(223, 28, 45, 0.38);
    box-shadow: 0 30px 85px rgba(20, 28, 45, 0.16);
  }

  .referral-image-link:focus-visible {
    outline: 3px solid rgba(223, 28, 45, 0.28);
    outline-offset: 4px;
  }

  .referral-image-link img {
    display: block;
    width: 100%;
    height: auto;
  }

  .agency-partner-band {
    margin-top: 0;
    background: #171821;
    color: white;
  }

  .agency-partner-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding-top: clamp(2.2rem, 5vw, 4rem);
    padding-bottom: clamp(2.2rem, 5vw, 4rem);
  }

  .agency-partner-inner h2 {
    max-width: 720px;
    margin: 0.4rem 0 0.7rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: white;
  }

  .agency-partner-inner p:not(.eyebrow) {
    max-width: 720px;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
  }

  .compact-partner-spotlight {
    margin-top: 0;
  }

  .compact-partner-spotlight .event-partner-spotlight-panel {
    grid-template-columns: 1fr auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .agency-partner-inner,
    .compact-partner-spotlight .event-partner-spotlight-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .referral-image-hero {
      padding-top: 0.85rem;
    }

    .referral-image-link {
      border-radius: 14px;
    }
  }
</style>
