---
import FAQ from "./FAQ.astro";
import { getLocalizedPath, type LocaleCode } from "../content/locales";
import { getPartnerPageContent } from "../content/partners";
import { realPortfolioProjects } from "../content/portfolio";

interface Props {
  locale: string;
}

const { locale = "en" } = Astro.props;
const currentLocale = locale as LocaleCode;
const partnerContent = getPartnerPageContent(currentLocale);
const contactHref = getLocalizedPath(currentLocale, "contact");
const portfolioHref = getLocalizedPath(currentLocale, "portfolio");
const eventPartnerHref = `/${currentLocale}/partners/event-organizers/`;
const becomePartnerHref = `${contactHref}?package=digitalAudit&project=partners&intent=partner_inquiry`;
const discoveryCallHref = `${contactHref}?package=digitalAudit&project=partners&intent=discovery_call`;
const referralHref = `${contactHref}?package=digitalAudit&project=referral&intent=refer_client`;

const referralCopy = {
  en: {
    eyebrow: "Websiteli referral program",
    title: "Know someone who needs a website? Get CHF 100.",
    intro: "Refer a business to Websiteli. If they become a paying client, you receive CHF 100.",
    noSelling: "No selling. No paperwork. Just make the introduction.",
    servicesLabel: "You can refer",
    services: [
      { title: "Websites", text: "Business websites, landing pages, ecommerce and redesigns." },
      { title: "Marketing & analytics", text: "SEO foundations, GA4, campaign tracking and marketing setup." },
      { title: "Automation", text: "Lead flows, integrations and repetitive business workflows." },
      { title: "AI & custom tools", text: "AI assistants, dashboards and tailored web applications." },
    ],
    stepsLabel: "How it works",
    steps: [
      { number: "1", title: "Make an introduction", text: "Connect us with someone who may need Websiteli." },
      { number: "2", title: "We handle everything", text: "We scope, propose and deliver the project directly." },
      { number: "3", title: "You get CHF 100", text: "We pay the reward after their first project is paid." },
    ],
    cta: "Refer someone",
    proofEyebrow: "Real work",
    proofTitle: "You are referring people to a builder with real projects.",
    proofText: "A few examples of websites and digital products already built by Websiteli.",
    caseStudy: "View case study",
    viewWebsite: "View website",
    agencyEyebrow: "For agencies & freelancers",
    agencyTitle: "Want more than a referral reward?",
    agencyText: "Websiteli can also work behind the scenes as your white-label technical partner for websites, automation and AI projects.",
    agencyPrimary: "See partnership models",
    agencySecondary: "Schedule a call",
    terms: "Referral reward is paid after the referred client's first paid project is received by Websiteli.",
    finalTitle: "Someone come to mind?",
    finalText: "Send the introduction and we will take it from there.",
  },
  de: {
    eyebrow: "Websiteli Empfehlungsprogramm",
    title: "Kennen Sie jemanden, der eine Website braucht? CHF 100 erhalten.",
    intro: "Empfehlen Sie ein Unternehmen an Websiteli. Wird daraus ein zahlender Kunde, erhalten Sie CHF 100.",
    noSelling: "Kein Verkauf. Kein Papierkram. Stellen Sie einfach den Kontakt her.",
    servicesLabel: "Das können Sie empfehlen",
    services: [
      { title: "Websites", text: "Unternehmenswebsites, Landingpages, Ecommerce und Redesigns." },
      { title: "Marketing & Analytics", text: "SEO-Grundlagen, GA4, Kampagnen-Tracking und Marketing-Setup." },
      { title: "Automation", text: "Lead-Flows, Integrationen und repetitive Geschäftsprozesse." },
      { title: "KI & individuelle Tools", text: "KI-Assistenten, Dashboards und maßgeschneiderte Webanwendungen." },
    ],
    stepsLabel: "So funktioniert es",
    steps: [
      { number: "1", title: "Kontakt herstellen", text: "Verbinden Sie uns mit jemandem, der Websiteli brauchen könnte." },
      { number: "2", title: "Wir übernehmen", text: "Wir klären Umfang, Angebot und Umsetzung direkt." },
      { number: "3", title: "CHF 100 erhalten", text: "Der Bonus wird nach Bezahlung des ersten Projekts ausgezahlt." },
    ],
    cta: "Jemanden empfehlen",
    proofEyebrow: "Echte Projekte",
    proofTitle: "Sie empfehlen einen Partner mit echten Projekten.",
    proofText: "Einige Beispiele für Websites und digitale Produkte von Websiteli.",
    caseStudy: "Case Study ansehen",
    viewWebsite: "Website ansehen",
    agencyEyebrow: "Für Agenturen & Freelancer",
    agencyTitle: "Mehr als nur eine Empfehlung?",
    agencyText: "Websiteli kann auch als White-Label-Technikpartner für Websites, Automation und KI-Projekte im Hintergrund arbeiten.",
    agencyPrimary: "Partnerschaftsmodelle ansehen",
    agencySecondary: "Gespräch buchen",
    terms: "Der Empfehlungsbonus wird ausgezahlt, nachdem Websiteli die Zahlung für das erste Projekt des empfohlenen Kunden erhalten hat.",
    finalTitle: "Fällt Ihnen jemand ein?",
    finalText: "Stellen Sie den Kontakt her – wir übernehmen den Rest.",
  },
  fr: {
    eyebrow: "Programme de recommandation Websiteli",
    title: "Vous connaissez quelqu'un qui a besoin d'un site ? Recevez CHF 100.",
    intro: "Recommandez une entreprise à Websiteli. Si elle devient cliente, vous recevez CHF 100.",
    noSelling: "Aucune vente. Aucune paperasse. Faites simplement l'introduction.",
    servicesLabel: "Vous pouvez recommander",
    services: [
      { title: "Sites web", text: "Sites d'entreprise, landing pages, ecommerce et refontes." },
      { title: "Marketing & analytics", text: "Bases SEO, GA4, tracking de campagnes et setup marketing." },
      { title: "Automatisation", text: "Flux de leads, intégrations et processus répétitifs." },
      { title: "IA & outils sur mesure", text: "Assistants IA, dashboards et applications web sur mesure." },
    ],
    stepsLabel: "Comment ça marche",
    steps: [
      { number: "1", title: "Faites l'introduction", text: "Mettez-nous en relation avec quelqu'un qui pourrait avoir besoin de Websiteli." },
      { number: "2", title: "Nous gérons tout", text: "Nous cadrons, proposons et livrons le projet directement." },
      { number: "3", title: "Recevez CHF 100", text: "La prime est versée après le paiement de son premier projet." },
    ],
    cta: "Recommander quelqu'un",
    proofEyebrow: "Projets réels",
    proofTitle: "Vous recommandez un partenaire avec de vrais projets.",
    proofText: "Quelques exemples de sites et produits digitaux réalisés par Websiteli.",
    caseStudy: "Voir l'étude de cas",
    viewWebsite: "Voir le site",
    agencyEyebrow: "Pour agences & freelances",
    agencyTitle: "Vous voulez plus qu'une prime de recommandation ?",
    agencyText: "Websiteli peut aussi travailler en marque blanche comme partenaire technique pour vos sites, automatisations et projets IA.",
    agencyPrimary: "Voir les modèles de partenariat",
    agencySecondary: "Planifier un appel",
    terms: "La prime est versée après réception par Websiteli du paiement du premier projet du client recommandé.",
    finalTitle: "Quelqu'un vous vient à l'esprit ?",
    finalText: "Faites l'introduction et nous nous occupons du reste.",
  },
  it: {
    eyebrow: "Programma referral Websiteli",
    title: "Conosci qualcuno che ha bisogno di un sito? Ricevi CHF 100.",
    intro: "Segnala un'azienda a Websiteli. Se diventa cliente pagante, ricevi CHF 100.",
    noSelling: "Nessuna vendita. Nessuna burocrazia. Fai semplicemente l'introduzione.",
    servicesLabel: "Puoi segnalare",
    services: [
      { title: "Siti web", text: "Siti aziendali, landing page, ecommerce e redesign." },
      { title: "Marketing & analytics", text: "Basi SEO, GA4, tracking campagne e setup marketing." },
      { title: "Automazione", text: "Lead flow, integrazioni e processi ripetitivi." },
      { title: "AI & tool personalizzati", text: "Assistenti AI, dashboard e applicazioni web su misura." },
    ],
    stepsLabel: "Come funziona",
    steps: [
      { number: "1", title: "Fai l'introduzione", text: "Mettici in contatto con qualcuno che potrebbe aver bisogno di Websiteli." },
      { number: "2", title: "Pensiamo a tutto noi", text: "Gestiamo scope, proposta e delivery direttamente." },
      { number: "3", title: "Ricevi CHF 100", text: "Il premio viene pagato dopo il pagamento del primo progetto." },
    ],
    cta: "Segnala qualcuno",
    proofEyebrow: "Lavori reali",
    proofTitle: "Stai consigliando un partner con progetti reali.",
    proofText: "Alcuni esempi di siti e prodotti digitali già realizzati da Websiteli.",
    caseStudy: "Vedi case study",
    viewWebsite: "Vedi sito",
    agencyEyebrow: "Per agenzie & freelance",
    agencyTitle: "Vuoi più di un semplice referral?",
    agencyText: "Websiteli può anche lavorare dietro le quinte come partner tecnico white-label per siti, automazione e progetti AI.",
    agencyPrimary: "Vedi i modelli di partnership",
    agencySecondary: "Prenota una call",
    terms: "Il premio referral viene pagato dopo che Websiteli ha ricevuto il pagamento del primo progetto del cliente segnalato.",
    finalTitle: "Ti viene in mente qualcuno?",
    finalText: "Fai l'introduzione e al resto pensiamo noi.",
  },
} as const;

const oneOffReferralCopy = {
  en: {
    badge: "One-off",
    title: "One-off Referral",
    summary: "Introduce a client to Websiteli. If they become a paying client, you receive a flat CHF 100 — and that's it.",
    points: ["One simple introduction", "No selling or project work", "Flat CHF 100 after their first project is paid"],
    cta: "Refer a client",
  },
  de: {
    badge: "Einmalig",
    title: "Einmalige Empfehlung",
    summary: "Stellen Sie Websiteli einen Kunden vor. Wird daraus ein zahlender Kunde, erhalten Sie einmalig CHF 100 — das ist alles.",
    points: ["Eine einfache Vorstellung", "Kein Verkauf und keine Projektarbeit", "Einmalig CHF 100 nach Bezahlung des ersten Projekts"],
    cta: "Kunden empfehlen",
  },
  fr: {
    badge: "Ponctuel",
    title: "Recommandation ponctuelle",
    summary: "Présentez un client à Websiteli. S'il devient client payant, vous recevez un montant fixe de CHF 100 — rien de plus à gérer.",
    points: ["Une simple mise en relation", "Aucune vente ni gestion de projet", "CHF 100 fixes après le paiement du premier projet"],
    cta: "Recommander un client",
  },
  it: {
    badge: "Una tantum",
    title: "Referral una tantum",
    summary: "Presenta un cliente a Websiteli. Se diventa un cliente pagante, ricevi CHF 100 una tantum — e finisce lì.",
    points: ["Una semplice presentazione", "Nessuna vendita o gestione del progetto", "CHF 100 una tantum dopo il pagamento del primo progetto"],
    cta: "Segnala un cliente",
  },
} as const;

const referral = referralCopy[currentLocale as keyof typeof referralCopy] ?? referralCopy.en;
const oneOffReferral = oneOffReferralCopy[currentLocale as keyof typeof oneOffReferralCopy] ?? oneOffReferralCopy.en;
const proofProjects = realPortfolioProjects.filter((project) => project.image && project.verifiedUrl).slice(0, 4);

function displayProjectName(name: string) {
  return name === "Jenifer Ciuciu-Kiss" ? "Personal Website" : name;
}
---

<main class="partners-page referral-page">
  <section class="section-shell referral-hero" aria-labelledby="partners-title">
    <div class="referral-hero-copy">
      <p class="eyebrow">{referral.eyebrow}</p>
      <h1 id="partners-title">{referral.title}</h1>
      <p class="referral-lead">{referral.intro}</p>
      <p class="referral-no-selling">{referral.noSelling}</p>
      <div class="hero-actions">
        <a class="button primary referral-primary" href={referralHref} data-track-event="partner_referral_click" data-track-label="Referral hero CHF 100">{referral.cta}</a>
        <a class="button secondary" href={portfolioHref} data-track-event="portfolio_cta_click" data-track-label="Referral hero portfolio">{referral.proofEyebrow}</a>
      </div>
      <p class="referral-terms">{referral.terms}</p>
    </div>

    <div class="referral-hero-card" aria-label={referral.stepsLabel}>
      <div class="reward-badge">
        <span>CHF</span>
        <strong>100</strong>
        <small>referral reward</small>
      </div>
      <p class="eyebrow">{referral.stepsLabel}</p>
      <div class="referral-steps">
        {referral.steps.map((step) => (
          <article>
            <span>{step.number}</span>
            <div>
              <h2>{step.title}</h2>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell referral-services" aria-labelledby="referral-services-title">
    <div class="section-heading compact-heading">
      <p class="eyebrow">{referral.servicesLabel}</p>
      <h2 id="referral-services-title">Websites, marketing, automation and AI.</h2>
    </div>
    <div class="referral-service-grid">
      {referral.services.map((service, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell section-block compact-top referral-proof" aria-labelledby="referral-proof-title">
    <div class="section-heading">
      <p class="eyebrow">{referral.proofEyebrow}</p>
      <h2 id="referral-proof-title">{referral.proofTitle}</h2>
      <p>{referral.proofText}</p>
    </div>
    <div class="referral-project-grid">
      {proofProjects.map((project) => (
        <article class="referral-project-card">
          <a href={`/${currentLocale}/portfolio/${project.slug}/`} class="referral-project-image" data-track-event="portfolio_case_study_click" data-track-label={`Referral page ${project.slug}`}>
            <img src={project.image} alt={project.imageAlt ?? `${project.name} project preview`} width="1200" height="760" loading="lazy" decoding="async" />
          </a>
          <div>
            <p class="project-kicker">{project.category}</p>
            <h3>{displayProjectName(project.name)}</h3>
            <div class="referral-project-links">
              <a href={`/${currentLocale}/portfolio/${project.slug}/`}>{referral.caseStudy} →</a>
              {project.url && <a href={project.url} target="_blank" rel="noopener">{referral.viewWebsite} ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="agency-partner-band" id="agency-partnership">
    <div class="section-shell agency-partner-inner">
      <div>
        <p class="eyebrow">{referral.agencyEyebrow}</p>
        <h2>{referral.agencyTitle}</h2>
        <p>{referral.agencyText}</p>
      </div>
      <div class="button-row">
        <a class="button primary" href="#partnership-models">{referral.agencyPrimary}</a>
        <a class="button secondary" href={discoveryCallHref} data-track-event="partner_cta_click" data-track-label="Referral page agency call">{referral.agencySecondary}</a>
      </div>
    </div>
  </section>

  <section class="section-shell section-block" id="partnership-models">
    <div class="section-heading centered">
      <p class="eyebrow">{partnerContent.sections.models.eyebrow}</p>
      <h2>{partnerContent.sections.models.title}</h2>
      <p>{partnerContent.sections.models.text}</p>
    </div>
    <div class="partners-model-grid">
      <article class="pricing-card partner-model-card referral-model-card">
        <span class="card-badge">{oneOffReferral.badge}</span>
        <h3>{oneOffReferral.title}</h3>
        <p>{oneOffReferral.summary}</p>
        <ul>
          {oneOffReferral.points.map((point) => <li>{point}</li>)}
        </ul>
        <a class="button primary" href={referralHref} data-track-event="partner_referral_click" data-track-label="One-off CHF 100 referral model">{oneOffReferral.cta}</a>
      </article>
      {partnerContent.models.slice(1).map((item) => (
        <article class:list={["pricing-card", "partner-model-card", item.recommended && "recommended", item.featured && "featured"]}>
          {item.badge && <span class="card-badge">{item.badge}</span>}
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <ul>
            {item.points.map((point) => <li>{point}</li>)}
          </ul>
          <a class="button secondary" href={item.featured ? discoveryCallHref : becomePartnerHref} data-track-event="partner_model_click" data-track-label={item.title}>{partnerContent.actions.discussModel}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell event-partner-spotlight compact-partner-spotlight" id="event-organizer-partnership" aria-labelledby="event-partner-spotlight-title">
    <div class="event-partner-spotlight-panel">
      <div>
        <p class="eyebrow">{partnerContent.eventPartnerSpotlight.eyebrow}</p>
        <h2 id="event-partner-spotlight-title">{partnerContent.eventPartnerSpotlight.title}</h2>
        <p>{partnerContent.eventPartnerSpotlight.text}</p>
      </div>
      <a class="button secondary" href={eventPartnerHref} data-track-event="partner_event_page_click" data-track-label="Referral page event partnership">{partnerContent.eventPartnerSpotlight.cta}</a>
    </div>
  </section>

  <section class="section-shell section-block compact-top faq-section" id="faq">
    <div class="section-heading">
      <p class="eyebrow">{partnerContent.sections.faq.eyebrow}</p>
      <h2>{partnerContent.sections.faq.title}</h2>
    </div>
    <div class="faq-list">
      {partnerContent.faqs.slice(0, 4).map((item) => <FAQ {...item} />)}
    </div>
  </section>

  <section class="partners-final-band referral-final-band" aria-labelledby="partners-final-title">
    <div class="section-shell partners-final-cta">
      <div>
        <p class="eyebrow">CHF 100 referral reward</p>
        <h2 id="partners-final-title">{referral.finalTitle}</h2>
        <p>{referral.finalText}</p>
      </div>
      <div class="button-row">
        <a class="button primary" href={referralHref} data-track-event="partner_referral_click" data-track-label="Referral final CTA">{referral.cta}</a>
        <a class="button secondary" href={discoveryCallHref}>{referral.agencySecondary}</a>
      </div>
    </div>
  </section>
</main>

<style>
  .referral-page {
    --referral-border: rgba(223, 28, 45, 0.2);
  }

  .referral-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .referral-hero-copy h1 {
    max-width: 820px;
    margin: 0.35rem 0 1rem;
    font-size: clamp(3rem, 6.5vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .referral-lead {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.45;
    color: var(--text, #171821);
    font-weight: 700;
  }

  .referral-no-selling {
    margin: 1rem 0 0;
    font-size: 1.05rem;
    color: var(--muted, #637084);
  }

  .referral-primary {
    box-shadow: 0 16px 38px rgba(223, 28, 45, 0.2);
  }

  .referral-terms {
    max-width: 640px;
    margin: 0.85rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted, #637084);
  }

  .referral-hero-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--referral-border);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 24px 70px rgba(20, 28, 45, 0.11);
  }

  .reward-badge {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .reward-badge span {
    color: #df1c2d;
    font-size: 1rem;
    font-weight: 900;
  }

  .reward-badge strong {
    font-size: clamp(3.5rem, 6vw, 5.8rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .reward-badge small {
    grid-column: 1 / -1;
    color: var(--muted, #637084);
    font-weight: 700;
  }

  .referral-steps {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.8rem;
  }

  .referral-steps article {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid rgba(20, 28, 45, 0.09);
  }

  .referral-steps article > span {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 50%;
    background: #df1c2d;
    color: white;
    font-weight: 900;
  }

  .referral-steps h2 {
    margin: 0;
    font-size: 1.05rem;
  }

  .referral-steps p {
    margin: 0.25rem 0 0;
    color: var(--muted, #637084);
    font-size: 0.93rem;
  }

  .referral-services {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .referral-service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .referral-service-grid article {
    padding: 1.35rem;
    border: 1px solid rgba(20, 28, 45, 0.09);
    border-radius: 16px;
    background: rgba(255,255,255,0.72);
  }

  .referral-service-grid article > span {
    color: #df1c2d;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .referral-service-grid h3 {
    margin: 0.55rem 0 0.4rem;
    font-size: 1.15rem;
  }

  .referral-service-grid p {
    margin: 0;
    color: var(--muted, #637084);
    line-height: 1.55;
  }

  .referral-project-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .referral-project-card {
    overflow: hidden;
    border: 1px solid rgba(20, 28, 45, 0.1);
    border-radius: 16px;
    background: white;
  }

  .referral-project-image {
    display: block;
    aspect-ratio: 1.58;
    overflow: hidden;
    background: #eef1f5;
  }

  .referral-project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .referral-project-card > div {
    padding: 1rem;
  }

  .referral-project-card h3 {
    margin: 0.2rem 0 0.75rem;
  }

  .referral-project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .agency-partner-band {
    margin-top: clamp(3rem, 6vw, 5rem);
    background: #171821;
    color: white;
  }

  .agency-partner-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding-top: clamp(2.2rem, 5vw, 4rem);
    padding-bottom: clamp(2.2rem, 5vw, 4rem);
  }

  .agency-partner-inner h2 {
