---
import CTASection from "./CTASection.astro";
import FAQ from "./FAQ.astro";
import OutreachBlock from "./OutreachBlock.astro";
import PackageCard from "./PackageCard.astro";
import PartnersPage from "./PartnersPage.astro";
import ProcessStep from "./ProcessStep.astro";
import { portfolioConcepts, realPortfolioProjects } from "../content/portfolio";
import { packageKeyByName, pricing } from "../config/pricing";
import { getPackageLabels } from "../config/packageLabels";
import { getBlogIndexContent, getBlogPosts, getMarketKeywords } from "../content/blog";
import { getFeaturedServices, getServiceCategoryServices } from "../content/services";
import { getWebsiteUseCaseForProject } from "../content/websiteUseCases";

interface Props {
  content: any;
  page: "services-pricing" | "portfolio" | "blog" | "about" | "contact" | "partners";
  locale: string;
}

const { content, page, locale } = Astro.props;
const contactHref = `/${locale}/contact/`;
const aboutIntroParts =
  typeof content.intro === "string" ? content.intro.split(/(?<=[.!?。！？])\s*/).filter(Boolean) : [];
const aboutProofTitle = aboutIntroParts[0] ?? content.intro;
const aboutProofText = aboutIntroParts.slice(1).join(" ") || content.intro;
const blogContent = getBlogIndexContent(locale as any);
const blogPosts = await getBlogPosts(locale as any);
const marketKeywords = getMarketKeywords();
const packageLabels = getPackageLabels(locale);
const websiteReviewHref = `${contactHref}?package=digitalAudit&project=website-review&intent=website_review`;
const serviceCategoryContent = getServiceCategoryServices();
const featuredServices = getFeaturedServices();
const swissPricing = pricing.CH;
function formatChf(amount: number) {
  return `from ${swissPricing.symbol} ${new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(amount)}`;
}
const processSteps = [
  {
    title: "Audit",
    description: "We clarify the business problem, existing website issues, target customers and the fastest path to a useful result.",
  },
  {
    title: "Build",
    description: "We create the website, tracking, forms, SEO foundations and integrations needed for leads and visibility.",
  },
  {
    title: "Improve",
    description: "We monitor performance, maintain the website and add automation where it saves time or improves follow-up.",
  },
];
const faqs = [
  {
    question: "Which package should I choose?",
    answer: "Website Review is for diagnosing the next best step, Digital Foundation is for a credible launch, Growth Setup is for more leads and bookings, AI/Data Upgrade is for automation, and Website Maintenance keeps the site healthy after launch.",
  },
  {
    question: "Do clients own their website?",
    answer: "Yes. Clients should own the domain, source code, analytics, Search Console, Google Business Profile access and website assets.",
  },
  {
    question: "Can Websiteli maintain an existing website?",
    answer: "Yes. Website Maintenance covers updates, monitoring, backups, small content changes, analytics reports, basic SEO monitoring and technical support.",
  },
];
const portfolioPageCopy: Record<
  string,
  {
    eyebrow: string;
    title: string;
    text: string;
    realEyebrow: string;
    realTitle: string;
    conceptsEyebrow: string;
    conceptsTitle: string;
    conceptsText: string;
    viewWebsite: string;
    linkPending: string;
    requestSimilar: string;
    exploreUseCase: string;
    finalCta: string;
  }
> = {
  en: {
    eyebrow: "Our work",
    title: "Websites and digital products we've designed and built.",
    text: "Real public projects appear first. Concepts and demos are clearly separated lower on the page.",
    realEyebrow: "Real projects",
    realTitle: "Public websites and Websiteli-owned work",
    conceptsEyebrow: "Concepts & experiments",
    conceptsTitle: "Reusable ideas for common business needs",
    conceptsText: "These examples are demos or concepts, not completed client websites.",
    viewWebsite: "View website",
    linkPending: "Website link being verified",
    requestSimilar: "Request something similar",
    exploreUseCase: "Explore use case",
    finalCta: "Get a free website review",
  },
  de: {
    eyebrow: "Unsere Arbeit",
    title: "Websites und digitale Produkte, die wir gestaltet und gebaut haben.",
    text: "Echte öffentliche Projekte erscheinen zuerst. Konzepte und Demos sind weiter unten klar getrennt.",
    realEyebrow: "Echte Projekte",
    realTitle: "Öffentliche Websites und Websiteli-eigene Arbeit",
    conceptsEyebrow: "Konzepte & Experimente",
    conceptsTitle: "Wiederverwendbare Ideen für typische Geschäftsanforderungen",
    conceptsText: "Diese Beispiele sind Demos oder Konzepte, keine abgeschlossenen Kundenwebsites.",
    viewWebsite: "Website ansehen",
    linkPending: "Website-Link wird geprüft",
    requestSimilar: "Ähnliches anfragen",
    exploreUseCase: "Use Case ansehen",
    finalCta: "Kostenlosen Website-Check anfragen",
  },
  fr: {
    eyebrow: "Nos réalisations",
    title: "Sites et produits digitaux que nous avons conçus et construits.",
    text: "Les vrais projets publics apparaissent d'abord. Les concepts et démos sont séparés plus bas.",
    realEyebrow: "Projets réels",
    realTitle: "Sites publics et travail Websiteli",
    conceptsEyebrow: "Concepts & expériences",
    conceptsTitle: "Idées réutilisables pour besoins fréquents",
    conceptsText: "Ces exemples sont des démos ou concepts, pas des sites clients terminés.",
    viewWebsite: "Voir le site",
    linkPending: "Lien du site en vérification",
    requestSimilar: "Demander un projet similaire",
    exploreUseCase: "Voir le cas d'usage",
    finalCta: "Demander une revue gratuite du site",
  },
  it: {
    eyebrow: "Il nostro lavoro",
    title: "Siti e prodotti digitali che abbiamo progettato e costruito.",
    text: "I progetti pubblici reali vengono prima. Concept e demo sono separati più in basso.",
    realEyebrow: "Progetti reali",
    realTitle: "Siti pubblici e lavoro Websiteli",
    conceptsEyebrow: "Concept ed esperimenti",
    conceptsTitle: "Idee riutilizzabili per esigenze comuni",
    conceptsText: "Questi esempi sono demo o concept, non siti cliente completati.",
    viewWebsite: "Vedi sito",
    linkPending: "Link del sito in verifica",
    requestSimilar: "Richiedi qualcosa di simile",
    exploreUseCase: "Vedi caso d'uso",
    finalCta: "Revisione gratuita del sito",
  },
};
const portfolioUi = portfolioPageCopy[locale] ?? portfolioPageCopy.en;
---

{
  page === "partners" && <PartnersPage locale={locale} />
}

{
  page === "services-pricing" && (
    <main class="subpage">
      <section class="section-shell page-hero">
        <p class="eyebrow">{content.nav.servicesPricing ?? "Services & Pricing"}</p>
        <h1>{content.packagesIntro.title}</h1>
        <p>{content.packagesIntro.text}</p>
      </section>

      <section class="pricing-page-overview" id="pricing">
        <div class="section-shell pricing-page-overview-inner">
          <div class="section-heading">
            <p class="eyebrow">Pricing</p>
            <h2>Starting prices you can understand before you contact us.</h2>
            <p>Exact scope depends on pages, content, languages, integrations and launch support, but the starting point should be visible.</p>
          </div>
          <div class="pricing-snapshot-grid">
            <article class="pricing-snapshot-card" data-package-card="digitalFoundation">
              <h3>{packageLabels.digitalFoundation}</h3>
              <p class="plan-price" data-package-price="digitalFoundation">{formatChf(swissPricing.packages.digitalFoundation.from)}</p>
              <p>For a professional website foundation, contact form, analytics, Search Console and SEO basics.</p>
            </article>
            <article class="pricing-snapshot-card" data-package-card="growthSetup">
              <h3>{packageLabels.growthSetup}</h3>
              <p class="plan-price" data-package-price="growthSetup">{formatChf(swissPricing.packages.growthSetup.from)}</p>
              <p>For more pages, lead capture, bookings, Google Business support and conversion tracking.</p>
            </article>
            <article class="pricing-snapshot-card" data-package-card="aiDataUpgrade">
              <h3>{packageLabels.aiDataUpgrade}</h3>
              <p class="plan-price" data-package-price="aiDataUpgrade">{formatChf(swissPricing.packages.aiDataUpgrade.from)}</p>
              <p>For automation, AI helpers, dashboards or custom workflows after the website foundation is clear.</p>
            </article>
            <article class="pricing-snapshot-card ownership-card">
              <h3>You own your website</h3>
              <p class="plan-price">Ownership</p>
              <p>Clients should own their domain, source, analytics, Search Console access and website assets.</p>
            </article>
          </div>
          <div class="button-row">
            <a class="button primary" href="#packages">Compare detailed packages</a>
            <a class="button secondary" href={websiteReviewHref} data-track-event="website_review_cta_click" data-track-label="Pricing page website review">Get a free website review</a>
          </div>
        </div>
      </section>

      <section class="section-shell section-block compact-top" id="problems">
        <div class="section-heading">
          <p class="eyebrow">Services</p>
          <h2>Websites first, then automation and custom tools when they help.</h2>
          <p>Start with a focused website package, then add automation, AI integrations or internal tools where they remove measurable manual work.</p>
        </div>
        <div class="category-grid">
          {serviceCategoryContent.map((category) => (
            <article class="category-card">
              <p class="eyebrow">{category.eyebrow}</p>
              <h3>{category.title}</h3>
              <p>{category.summary}</p>
              <ul>
                {category.services.slice(0, 6).map((service) => <li>{service.shortTitle}</li>)}
              </ul>
              <a class="button secondary" href={`/${locale}/services/${category.services[0].slug}/`}>Explore {category.eyebrow.toLowerCase()}</a>
            </article>
          ))}
        </div>
        <div class="section-heading compact-heading">
          <p class="eyebrow">Popular starting points</p>
          <h2>Dedicated pages for common requests.</h2>
        </div>
        <div class="link-grid expanded">
          {featuredServices.map((service) => (
            <a href={`/${locale}/services/${service.slug}/`} data-track-event="service_card_click" data-track-label={service.slug}>
              <span>{service.shortTitle}</span>
              <strong>{service.description}</strong>
            </a>
          ))}
        </div>
      </section>

      <section class="section-shell inline-cta demo-discovery-cta">
        <a class="button primary" href={`/${locale}/portfolio/`} data-track-event="portfolio_cta_click" data-track-label="Pricing page portfolio">See our work</a>
        <a class="button secondary" href={websiteReviewHref} data-track-event="website_review_cta_click" data-track-label="Pricing page inline website review">Get a free website review</a>
      </section>

      <section class="section-shell section-block compact-top" id="process">
        <div class="section-heading">
          <p class="eyebrow">Process</p>
          <h2>From first conversation to a website you can own and improve.</h2>
        </div>
        <div class="process-grid">
          {processSteps.map((step, index) => <ProcessStep {...step} index={index + 1} />)}
        </div>
      </section>

      <section class="section-shell section-block compact-top" id="packages">
        <div class="section-heading">
          <p class="eyebrow">{content.packagesIntro.eyebrow}</p>
          <h2>{content.packagesIntro.title}</h2>
          <p>{content.packagesIntro.text}</p>
        </div>
        <p class="pricing-note">{content.ui?.pricingNote ?? "Final quote after a short consultation."}</p>
        <div class="pricing-grid package-grid">
          {content.packages.map((item) => {
            const packageKey = packageKeyByName[item.name];
            return <PackageCard {...item} displayName={packageLabels[packageKey]} ui={content.ui} packageKey={packageKey} contactHref={contactHref} />;
          })}
        </div>
      </section>

      <section class="section-shell section-block compact-top faq-section" id="faq">
        <div class="section-heading">
          <p class="eyebrow">FAQ</p>
          <h2>Questions before requesting a consultation.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => <FAQ {...item} />)}
        </div>
      </section>

      <CTASection content={content} />
    </main>
  )
}

{
  page === "portfolio" && (
    <main class="subpage">
      <section class="section-shell page-hero">
        <p class="eyebrow">{portfolioUi.eyebrow}</p>
        <h1>{portfolioUi.title}</h1>
        <p>{portfolioUi.text}</p>
      </section>

      <section class="section-shell section-block compact-top" id="live-demos">
        <div class="section-heading">
          <p class="eyebrow">{portfolioUi.realEyebrow}</p>
          <h2>{portfolioUi.realTitle}</h2>
        </div>
        <div class="portfolio-visual-grid">
          {realPortfolioProjects.map((project) => {
            const requestHref = `${contactHref}?package=digitalFoundation&relatedProject=${project.slug}&sourcePage=/${locale}/portfolio/&intent=request_similar_project`;
            const websiteUseCase = getWebsiteUseCaseForProject(project);
            return (
            <article class:list={["portfolio-visual-card", project.featured && "featured-project"]} itemscope itemtype="https://schema.org/CreativeWork">
              <div class="portfolio-visual-preview">
                {project.image ? (
                  <img src={project.image} alt={project.imageAlt ?? `${project.name} website screenshot`} loading="lazy" decoding="async" width="1200" height="760" itemprop="image" />
                ) : (
                  <div class="screenshot-pending compact">
                    <span>{project.category}</span>
                    <strong>{project.name}</strong>
                    <small>{project.expectedImage ? `Expected asset: ${project.expectedImage}` : portfolioUi.linkPending}</small>
                  </div>
                )}
              </div>
              <div class="project-card-body">
                <p class="project-kicker">{project.category}</p>
                <h3 itemprop="name">{project.name}</h3>
                <p itemprop="description">{project.description}</p>
                <div class="button-row">
                  {project.verifiedUrl && project.url ? (
                    <a class="button primary" href={project.url} target="_blank" rel="noopener" data-track-event="portfolio_project_click" data-track-label={project.slug}>{portfolioUi.viewWebsite}</a>
                  ) : (
                    <span class="button secondary disabled-button" title={project.verificationNote}>{portfolioUi.linkPending}</span>
                  )}
                  <a class="button secondary" href={requestHref} data-track-event="portfolio_project_request_click" data-track-label={project.slug}>{portfolioUi.requestSimilar}</a>
                  {websiteUseCase && (
                    <a class="button secondary" href={`/${locale}/websites/${websiteUseCase.slug}/`} data-track-event="portfolio_use_case_click" data-track-label={`${project.slug}:${websiteUseCase.slug}`}>{portfolioUi.exploreUseCase}</a>
                  )}
                </div>
              </div>
            </article>
            );
          })}
        </div>
      </section>

      <section class="section-shell section-block compact-top" id="concepts">
        <div class="section-heading">
          <p class="eyebrow">{portfolioUi.conceptsEyebrow}</p>
          <h2>{portfolioUi.conceptsTitle}</h2>
          <p>{portfolioUi.conceptsText}</p>
        </div>
        <div class="demo-grid concept-demo-grid">
          {portfolioConcepts.map((concept) => {
            const requestHref = `${contactHref}?package=digitalFoundation&relatedDemo=${concept.slug}&sourcePage=/${locale}/portfolio/&intent=${concept.requestIntent}`;
            return (
            <article class="demo-card concept-demo-card">
              <div class="portfolio-visual-preview compact">
                {concept.image ? (
                  <img src={concept.image} alt={`${concept.name} demo preview`} loading="lazy" width="1200" height="760" />
                ) : (
                  <div class="work-placeholder">
                    <span>{concept.category}</span>
                    <strong>{concept.name}</strong>
                  </div>
                )}
              </div>
              <div class="concept-card-meta">
                <span>{concept.category}</span>
                <span>Concept demo</span>
              </div>
              <h3>{concept.name}</h3>
              <p>{concept.description}</p>
              <ul class="compact-list">
                {concept.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
              </ul>
              <a href={requestHref} data-track-event="portfolio_concept_request_click" data-track-label={concept.slug}>{portfolioUi.requestSimilar}</a>
            </article>
            );
          })}
        </div>
      </section>
      <section class="section-shell inline-cta">
        <a class="button primary" href={`${contactHref}?package=digitalAudit&project=website-review&intent=website_review`} data-track-event="website_review_cta_click" data-track-label="Portfolio final CTA">{portfolioUi.finalCta}</a>
        <a class="button secondary" href={`/${locale}/services-pricing/`}>{content.nav.servicesPricing ?? "Services & Pricing"}</a>
      </section>
    </main>
  )
}

{
  page === "blog" && (
    <main class="subpage blog-page">
      <section class="section-shell page-hero">
        <p class="eyebrow">{blogContent.eyebrow}</p>
        <h1>{blogContent.title}</h1>
        <p>{blogContent.text}</p>
      </section>
      <section class="section-shell section-block compact-top">
        <div class="blog-tools" aria-label="Blog filters">
          <label>
            <span>{blogContent.searchLabel}</span>
            <input type="search" placeholder="SEO, AI, restaurant, Google Business" data-blog-search />
          </label>
          <div>
            <span>{blogContent.categoriesLabel}</span>
            <div class="keyword-clusters">
              {marketKeywords.slice(0, 8).map((keyword) => <span>{keyword}</span>)}
            </div>
          </div>
        </div>
        <div class="blog-grid">
          {blogPosts.map((post) => (
            <article class="blog-card" data-blog-card data-blog-text={`${post.title} ${post.description} ${post.tags.join(" ")}`}>
              <img src={post.featuredImage} alt={post.imageAlt} loading="lazy" decoding="async" width={post.featuredImageWidth} height={post.featuredImageHeight} />
              <div>
                <p class="eyebrow">{blogContent.featured}</p>
                <h2>{post.title}</h2>
                <p>{post.excerpt}</p>
                <div class="blog-meta">
                  <span>{post.category}</span>
                  <span>{post.readingTime}</span>
                  <span>{post.publishedAt}</span>
                </div>
                <a class="button primary" href={`/${locale}/blog/${post.slug}/`}>{blogContent.readArticle}</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  )
}

{
  page === "about" && (
    <main class="subpage about-page">
      <section class="section-shell page-hero about-hero">
        <div class="about-hero-copy">
          <p class="eyebrow">{content.about.eyebrow}</p>
          <h1>{content.about.title}</h1>
          <p>{content.about.text}</p>
        </div>
        <div class="about-hero-panel" aria-label="Websiteli highlights">
          {content.badges.slice(0, 4).map((badge) => <span>{badge}</span>)}
        </div>
      </section>
      <section class="why-section about-proof-section">
        <div class="section-shell why-inner about-proof-inner">
          <div class="section-heading about-proof-copy">
            <p class="eyebrow">Websiteli</p>
            <h2>{aboutProofTitle}</h2>
            <p>{aboutProofText}</p>
          </div>
          <div class="reason-grid about-reason-grid">
            {content.badges.map((badge) => <div>{badge}</div>)}
          </div>
        </div>
      </section>
      <OutreachBlock outreach={content.outreach} contactHref={contactHref} ui={content.ui} />
    </main>
  )
}

{
  page === "contact" && (
    <main class="subpage">
      <section class="section-shell page-hero">
        <p class="eyebrow">{content.contact.eyebrow}</p>
        <h1>{content.contact.title}</h1>
        <p>{content.contact.text}</p>
      </section>
      <CTASection content={content} />
    </main>
  )
}

<script>
  const blogSearch = document.querySelector("[data-blog-search]");
  const blogCards = Array.from(document.querySelectorAll("[data-blog-card]"));

  blogSearch?.addEventListener("input", () => {
    const query = blogSearch instanceof HTMLInputElement ? blogSearch.value.trim().toLowerCase() : "";
    blogCards.forEach((card) => {
      const text = card instanceof HTMLElement ? card.dataset.blogText?.toLowerCase() ?? "" : "";
      card.toggleAttribute("hidden", Boolean(query && !text.includes(query)));
    });
  });
</script>
