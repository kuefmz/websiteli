---
import { realPortfolioProjects } from '../content/portfolio';
import Expertise from './PremiumExpertise.astro';
const projects = realPortfolioProjects.filter(p => ['movere-clinic','slap-ai','before-you-trust','semantic-web-science-association'].includes(p.slug));
const stages = [ ['Discover','We begin by understanding your business, objectives, and challenges.'], ['Design','We develop a clear strategy and create a solution tailored to your needs.'], ['Deliver','We implement with attention to detail, reliability, and technical quality.'], ['Evolve','We support continuous improvement as your business develops.'] ];
---
<main class="premium-home" id="home">
  <section class="premium-hero section-shell">
    <div class="premium-hero-top"><p class="eyebrow">Swiss Digital Consultancy</p><span>Design. Engineering. Intelligence.</span></div>
    <div class="premium-hero-grid">
      <div class="premium-hero-copy"><h1>Digital Excellence.<br/><em>Thoughtfully</em><br/>Engineered.</h1><p>We create distinctive digital experiences, intelligent automations, and connected systems that help ambitious businesses operate and grow with confidence.</p><div class="button-row"><a class="button primary" href="/en/contact/">Discuss Your Project <span aria-hidden="true">↗</span></a><a class="text-link" href="#expertise">Explore Our Expertise <span aria-hidden="true">↓</span></a></div></div>
      <figure class="precision-study" aria-label="Architectural study of aligned planes, inspired by Swiss precision"><div class="study-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><span class="study-axis"></span></div><figcaption><span>FORM / FUNCTION</span><span>Study No. 01 — Alignment</span></figcaption></figure>
    </div>
    <div class="premium-hero-bottom"><span>Swiss-based. International outlook.</span><a href="#introduction">A considered way forward <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="section-shell premium-intro" id="introduction"><p class="eyebrow">Purpose before technology</p><div><h2>Technology should elevate your business.<br/><em>Not complicate it.</em></h2><p>At Websiteli, we combine thoughtful design with technical expertise to create digital solutions tailored to the way your business works. From refined websites to intelligent workflows, every solution is built with purpose.</p></div></section>
  <Expertise locale="en" />
  <section class="premium-process" id="approach"><span id="process" class="anchor-marker" aria-hidden="true"></span><div class="section-shell"><div class="premium-section-heading"><p class="eyebrow">Our approach</p><h2>A Thoughtful Approach<br/>to Digital Progress.</h2></div><div class="premium-stages">{stages.map(([title,text],i)=><article><span class="index">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section-shell premium-partnership" id="partnership"><span id="industries" class="anchor-marker" aria-hidden="true"></span><div><p class="eyebrow">Why Websiteli</p><h2>A More Considered<br/><em>Digital Partnership.</em></h2><p>Founder-led and Swiss-based. You work directly with the people designing and engineering your solution, from the first conversation through delivery and ongoing support.</p><a class="text-link" href="/en/about/">Meet Websiteli <span aria-hidden="true">↗</span></a></div><ol>{['Swiss-inspired precision and attention to detail','Design and engineering, considered together','Tailored solutions rather than generic templates','Clear communication and transparent collaboration','Long-term thinking and maintainable technology'].map((item,i)=><li><span>0{i+1}</span>{item}</li>)}</ol></section>
  <section class="premium-work section-shell" id="work"><div class="premium-section-heading"><div><p class="eyebrow">Selected work</p><h2>Ideas made tangible.</h2></div><a class="text-link" href="/en/portfolio/">Explore the full portfolio <span aria-hidden="true">↗</span></a></div><div class="premium-projects">{projects.map(project=><article><a class="premium-project-image" href={`/en/portfolio/#${project.slug}`}><img src={project.image} alt={project.imageAlt} width="1200" height="760" loading="lazy" decoding="async" /></a><div class="premium-project-title"><h3><a href={`/en/portfolio/#${project.slug}`}>{project.name}</a></h3><span>{project.category}</span></div><p>{project.description}</p><a class="text-link" href={project.url} target="_blank" rel="noopener">View project <span aria-hidden="true">↗</span></a></article>)}</div></section>
  <section class="premium-final" id="contact"><div class="section-shell"><p class="eyebrow">Explore a collaboration</p><h2>Your Next Digital<br/>Chapter <em>Starts Here.</em></h2><p>Whether you're refining your digital presence or rethinking how your business operates, we'd be delighted to explore what's possible.</p><a class="button light" href="/en/contact/">Start a Conversation <span aria-hidden="true">↗</span></a><small>Every collaboration begins with understanding your ambitions.</small></div></section>
</main>
