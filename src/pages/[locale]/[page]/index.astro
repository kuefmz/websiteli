---
import PageSections from "../../../components/PageSections.astro";
import Layout from "../../../layouts/Layout.astro";
import {
  getAlternates,
  getLocaleContent,
  getLocalizedPath,
  legacyPageSlugs,
  legacyRedirects,
  localeCodes,
  pageNavKeys,
  pageSlugs,
  type LocaleCode,
  type PageSlug,
  type LegacyPageSlug,
} from "../../../content/locales";
import { getBlogIndexContent } from "../../../content/blog";
import { getPartnerPageContent } from "../../../content/partners";

export function getStaticPaths() {
  return localeCodes.flatMap((locale) => [...pageSlugs, ...legacyPageSlugs].map((page) => ({ params: { locale, page } })));
}

const locale = Astro.params.locale as LocaleCode;
const requestedPage = Astro.params.page as PageSlug | LegacyPageSlug;
const redirectTarget = requestedPage in legacyRedirects ? getLocalizedPath(locale, requestedPage) : "";

const page = requestedPage as PageSlug;
const content = getLocaleContent(locale);
const blogContent = getBlogIndexContent(locale);
const partnerContent = getPartnerPageContent(locale);
const siteUrl = new URL("https://websiteli.ch");
const label = content.nav[pageNavKeys[page]] ?? (page === "blog" ? blogContent.eyebrow : page);
const servicesPricingSeoByLocale: Partial<Record<LocaleCode, { title: string; description: string }>> = {
  en: {
    title: "Website Services & Pricing in Switzerland | Websiteli",
    description:
      "Compare Websiteli website services and pricing for business websites, SEO, maintenance, lead generation, automation and AI projects in Switzerland.",
  },
  de: {
    title: "Website-Services & Preise in der Schweiz | Websiteli",
    description:
      "Vergleichen Sie Websiteli-Services und Preise für Business-Websites, SEO, Wartung, Leadgenerierung, Automation und KI-Projekte in der Schweiz.",
  },
};
const portfolioSeoByLocale: Partial<Record<LocaleCode, { title: string; description: string }>> = {
  en: {
    title: "Web Design Portfolio: Real Websites Built by Websiteli",
    description:
      "See real websites and web applications built by Websiteli for healthcare, products, portfolios, research, trust and discovery projects.",
  },
  de: {
    title: "Webdesign-Portfolio: Echte Websites von Websiteli",
    description:
      "Sehen Sie echte Websites und Webanwendungen von Websiteli für Healthcare, Produkte, Portfolios, Forschung, Trust- und Discovery-Projekte.",
  },
};
const servicesPricingSeo = servicesPricingSeoByLocale[locale] ?? {
  title: `${content.nav.servicesPricing ?? "Services & Pricing"} - Websiteli`,
  description: content.packagesIntro.text,
};
const portfolioSeo = portfolioSeoByLocale[locale] ?? {
  title: `${content.nav.portfolio ?? "Portfolio"} - Websiteli`,
  description: "Websiteli portfolio with real public websites, Websiteli-owned work and clearly separated concept demos.",
};
const title =
  page === "partners"
    ? partnerContent.seo.title
    : page === "portfolio"
    ? portfolioSeo.title
    : page === "blog"
      ? blogContent.seo.title
      : page === "services-pricing"
        ? servicesPricingSeo.title
        : `${label} - Websiteli`;
const description =
  page === "partners"
    ? partnerContent.seo.description
    : page === "services-pricing"
    ? servicesPricingSeo.description
    : page === "portfolio"
      ? portfolioSeo.description
      : page === "blog"
        ? blogContent.seo.description
        : page === "about"
        ? content.about.text
        : content.contact.text;
const servicesPricingFaqs = [
  {
    question: "Which package should I choose?",
    answer:
      "Website Review is for diagnosing the next best step, Digital Foundation is for a credible launch, Growth Setup is for more leads and bookings, AI/Data Upgrade is for automation, and Website Maintenance keeps the site healthy after launch.",
  },
  {
    question: "Do clients own their website?",
    answer: "Yes. Clients should own the domain, source code, analytics, Search Console, Google Business Profile access and website assets.",
  },
  {
    question: "Can Websiteli maintain an existing website?",
    answer:
      "Yes. Website Maintenance covers updates, monitoring, backups, small content changes, analytics reports, basic SEO monitoring and technical support.",
  },
];
const pageSchema =
  page === "partners"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Service",
          name: partnerContent.schema.name,
          provider: {
            "@type": "Organization",
            name: "Websiteli",
            url: siteUrl.toString(),
          },
          areaServed: {
            "@type": "Country",
            name: partnerContent.schema.areaServed,
          },
          audience: partnerContent.audiences.map((item) => ({
            "@type": "Audience",
            audienceType: item.title,
          })),
          serviceType: partnerContent.schema.serviceTypes,
          description: partnerContent.seo.description,
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: partnerContent.faqs.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : page === "services-pricing"
      ? [
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            mainEntity: servicesPricingFaqs.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: {
                "@type": "Answer",
                text: item.answer,
              },
            })),
          },
        ]
    : [];
const redirectCanonicalUrl = redirectTarget ? new URL(redirectTarget, siteUrl).toString() : "";
---

{
  redirectTarget ? (
    <html lang={locale}>
      <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex, follow" />
        <link rel="canonical" href={redirectCanonicalUrl} />
        <script is:inline define:vars={{ redirectTarget }}>
          try {
            window.sessionStorage?.setItem("websiteli_redirect_context", JSON.stringify({
              landingPage: window.location.href,
              referrer: document.referrer || "",
            }));
          } catch {}
          const target = new URL(redirectTarget, window.location.origin);
          target.search = window.location.search;
          target.hash = window.location.hash;
          window.location.replace(target.toString());
        </script>
        <title>Websiteli</title>
      </head>
      <body>
        <a href={redirectTarget}>Continue to Websiteli</a>
      </body>
    </html>
  ) : (
    <Layout
      title={title}
      description={description}
      canonicalPath={getLocalizedPath(locale, page)}
      lang={locale}
      locale={locale}
      page={page}
      alternates={getAlternates(page)}
      content={content}
      schema={pageSchema}
    >
      <PageSections content={content} page={page} locale={locale} />
    </Layout>
  )
}
