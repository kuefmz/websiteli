---
import Layout from "../../../layouts/Layout.astro";
import MarketScan from "../../../components/MarketScan.astro";

export function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "de" } }];
}
const locale = Astro.params.locale === "de" ? "de" : "en";
const apiBase = import.meta.env.PUBLIC_MARKET_SCAN_API_URL || "http://localhost:8787";
const meta = locale === "de" ? {
  title:"Kostenloser Market Scan | Websiteli",
  description:"Gib Websiteli eine URL und erhalte öffentliche Buyer Signals, Reddit-Diskussionen, Review-Erwähnungen, Wettbewerber-Kandidaten und Content-Chancen."
} : {
  title:"Free Market Scan | Websiteli",
  description:"Give Websiteli one URL and uncover public buyer signals, Reddit discussions, review mentions, competitor candidates and content opportunities."
};
const alternates = [
  { locale: "en", href: "/en/market-scan/" },
  { locale: "de", href: "/de/market-scan/" },
];
---
<Layout
  title={meta.title}
  description={meta.description}
  canonicalPath={`/${locale}/market-scan/`}
  lang={locale}
  locale={locale}
  page="market-scan"
  alternates={alternates}
>
  <MarketScan locale={locale} apiBase={apiBase} />
</Layout>
