---
import EventOrganizerPartnersPage from "../../../../components/EventOrganizerPartnersPage.astro";
import Layout from "../../../../layouts/Layout.astro";
import { getLocaleContent, localeCodes, type LocaleCode } from "../../../../content/locales";
import { getEventOrganizerPartnerPageContent } from "../../../../content/partners";

export function getStaticPaths() {
  return localeCodes.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocaleCode;
const content = getLocaleContent(locale);
const pageContent = getEventOrganizerPartnerPageContent(locale);
const canonicalPath = `/${locale}/partners/event-organizers/`;
const alternates = localeCodes.map((code) => ({
  locale: code,
  href: `/${code}/partners/event-organizers/`,
}));
const siteUrl = new URL("https://websiteli.ch");
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Event organizer website partnership",
    provider: {
      "@type": "Organization",
      name: "Websiteli",
      url: siteUrl.toString(),
    },
    areaServed: [
      { "@type": "Country", name: "Switzerland" },
      { "@type": "Place", name: "Europe" },
      { "@type": "Place", name: "International" },
    ],
    audience: pageContent.audiences.map((item) => ({
      "@type": "Audience",
      audienceType: item,
    })),
    serviceType: [
      "Event website development",
      "Wedding website development",
      "Event organizer referral partnership",
      "Custom event website design",
      "Multilingual event websites",
    ],
    description: pageContent.seo.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: pageContent.faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Partners",
        item: new URL(`/${locale}/partners/`, siteUrl).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Event Organizers",
        item: new URL(canonicalPath, siteUrl).toString(),
      },
    ],
  },
];
---

<Layout
  title={pageContent.seo.title}
  description={pageContent.seo.description}
  canonicalPath={canonicalPath}
  lang={locale}
  locale={locale}
  page="partners"
  alternates={alternates}
  content={content}
  schema={pageSchema}
  image={pageContent.hero.image}
>
  <EventOrganizerPartnersPage locale={locale} />
</Layout>
