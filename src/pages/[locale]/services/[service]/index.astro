---
import CTASection from "../../../../components/CTASection.astro";
import FAQ from "../../../../components/FAQ.astro";
import Layout from "../../../../layouts/Layout.astro";
import { packageKeys } from "../../../../config/pricing";
import { getPackageLabels } from "../../../../config/packageLabels";
import { getLocaleContent, localeCodes, type LocaleCode } from "../../../../content/locales";
import { getServiceDetail } from "../../../../content/serviceDetails";
import {
  getRelatedServices,
  getServiceBySlug,
  serviceCategoryDetails,
  serviceSlugs,
  type ServicePage,
} from "../../../../content/services";

export function getStaticPaths() {
  return localeCodes.flatMap((locale) => serviceSlugs.map((service) => ({ params: { locale, service } })));
}

const locale = Astro.params.locale as LocaleCode;
const service = getServiceBySlug(Astro.params.service) as ServicePage;
const detail = getServiceDetail(service.slug);
const content = getLocaleContent(locale);
const category = serviceCategoryDetails[service.category];
const packageLabels = getPackageLabels(locale);
const contactHref = `/${locale}/contact/?package=${service.packageKey}&sourcePage=/${locale}/services/${service.slug}/&intent=service_consultation`;
const pricingHref = `/${locale}/services-pricing/`;
const servicesHref = `/${locale}/services-pricing/#problems`;
const canonicalPath = `/${locale}/services/${service.slug}/`;
const alternates = localeCodes.map((code) => ({ locale: code, href: `/${code}/services/${service.slug}/` }));
const relatedServices = getRelatedServices(service);
const primaryCtaLabel = detail ? "Discuss your workflow" : "Request this service";
const bottomCtaLabel = detail ? "Discuss your content workflow" : `Request ${service.shortTitle}`;
const showContentPipelineArchitecture = service.slug === "ai-content-pipelines";
const defaultFaqs = [
  {
    question: "What problem does this service solve?",
    answer: service.problem,
  },
  {
    question: `Is ${service.shortTitle.toLowerCase()} suitable for a small business?`,
    answer: `Yes. Websiteli scopes ${service.title.toLowerCase()} around the workflow, budget and team capacity of the business, then starts with the smallest useful version before expanding.`,
  },
  {
    question: `What does ${service.shortTitle.toLowerCase()} cost?`,
    answer: service.investment,
  },
];
const serviceFaqs = detail?.faqs ?? defaultFaqs;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    serviceType: service.title,
    category: category.eyebrow,
    provider: {
      "@type": "Organization",
      name: "Websiteli",
      url: "https://websiteli.ch",
    },
    areaServed: ["Switzerland", "Europe", "International"],
    description: service.description,
    offers: {
      "@type": "Offer",
      name: packageLabels[service.packageKey] ?? service.title,
      priceCurrency: "CHF",
      description: service.investment,
      availability: "https://schema.org/InStock",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `https://websiteli.ch/${locale}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `https://websiteli.ch/${locale}/services-pricing/`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: service.title,
        item: `https://websiteli.ch${canonicalPath}`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: serviceFaqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
  ...(service.category === "ai" || service.category === "custom-software"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          name: service.title,
          applicationCategory: "BusinessApplication",
          operatingSystem: "Web",
          description: service.description,
          offers: {
            "@type": "Offer",
            priceCurrency: "CHF",
            description: service.investment,
          },
        },
      ]
    : []),
];
---

<Layout
  title={detail?.seoTitle ?? `${service.title} - Websiteli`}
  description={service.description}
  canonicalPath={canonicalPath}
  lang={locale}
  locale={locale}
  page="services-pricing"
  alternates={alternates}
  content={content}
  schema={schema}
>
  <main class="subpage detail-page service-detail">
    <section class="section-shell page-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={`/${locale}/`}>Home</a>
        <span>/</span>
        <a href={pricingHref}>{content.nav.servicesPricing ?? "Services & Pricing"}</a>
        <span>/</span>
        <span>{service.title}</span>
      </nav>
      <p class="eyebrow">{category.eyebrow}</p>
      <h1>{service.title}</h1>
      <p>{detail?.intro ?? service.description}</p>
      <div class="button-row">
        <a class="button primary" href={contactHref} data-track-event="service_cta_click" data-track-label={service.slug}>{primaryCtaLabel}</a>
        <a class="button secondary" href={pricingHref}>Compare packages</a>
      </div>
    </section>

    <section class="section-shell detail-grid compact-top" aria-label={`${service.title} details`}>
      <article class="detail-panel">
        <p class="eyebrow">Problem</p>
        <h2>Where this helps</h2>
        <p>{service.problem}</p>
      </article>
      <article class="detail-panel">
        <p class="eyebrow">Solution</p>
        <h2>What Websiteli builds</h2>
        <p>{service.solution}</p>
      </article>
    </section>

    {detail?.examples && (
      <section class="section-shell section-block compact-top" aria-labelledby="service-examples-heading">
        <div class="section-heading">
          <p class="eyebrow">Practical examples</p>
          <h2 id="service-examples-heading">What an AI content pipeline can do</h2>
        </div>
        <div class="value-grid">
          {detail.examples.map((example) => (
            <article class="mini-card">
              <h3>{example.title}</h3>
              <p>{example.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {showContentPipelineArchitecture && (
      <section class="section-shell section-block compact-top pipeline-architecture" aria-labelledby="pipeline-architecture-heading">
        <div class="section-heading">
          <p class="eyebrow">Architecture</p>
          <h2 id="pipeline-architecture-heading">A controlled path from business input to approved publication</h2>
          <p>The pipeline separates source material, automated preparation, quality checks and human approval. Each stage has a clear responsibility, so speed does not replace accuracy.</p>
        </div>

        <ol class="pipeline-flow" aria-label="AI content pipeline architecture">
          <li>
            <span class="pipeline-step-number">01</span>
            <strong>Approved inputs</strong>
            <small>Content calendar, product facts, brand guidance and verified source material.</small>
          </li>
          <li>
            <span class="pipeline-step-number">02</span>
            <strong>Structured brief</strong>
            <small>Audience, search intent, required sections, channels, language and CTA.</small>
          </li>
          <li>
            <span class="pipeline-step-number">03</span>
            <strong>AI-assisted draft</strong>
            <small>First draft, metadata, FAQs and channel-specific variations.</small>
          </li>
          <li>
            <span class="pipeline-step-number">04</span>
            <strong>Automated checks</strong>
            <small>Required fields, unsupported claims, links, formatting and duplicate-topic checks.</small>
          </li>
          <li>
            <span class="pipeline-step-number">05</span>
            <strong>Human approval</strong>
            <small>An editor verifies facts, tone, usefulness and the final publishing decision.</small>
          </li>
          <li>
            <span class="pipeline-step-number">06</span>
            <strong>Publish and learn</strong>
            <small>Publish to approved channels, record revisions and use performance data for the next cycle.</small>
          </li>
        </ol>

        <article class="pipeline-example" aria-labelledby="pipeline-example-heading">
          <div>
            <p class="eyebrow">Small-business example</p>
            <h3 id="pipeline-example-heading">A Zurich consultancy turns one expert article into a reviewed weekly content set</h3>
          </div>
          <div class="pipeline-example-grid">
            <div>
              <strong>Input</strong>
              <p>An approved article outline, service facts, target audience, primary keyword and consultation CTA.</p>
            </div>
            <div>
              <strong>Pipeline output</strong>
              <p>A blog draft, German review copy, LinkedIn summary, newsletter excerpt, metadata, FAQs and internal-link suggestions.</p>
            </div>
            <div>
              <strong>Approval rule</strong>
              <p>Nothing is published until a person confirms the claims, links, tone and language quality.</p>
            </div>
            <div>
              <strong>What is measured</strong>
              <p>Revision time, recurring errors, approved-versus-rejected drafts and useful actions such as article-to-contact visits.</p>
            </div>
          </div>
        </article>
      </section>
    )}

    <section class="section-shell section-block compact-top">
      <div class="section-heading">
        <p class="eyebrow">Benefits</p>
        <h2>Business outcomes before technology choices.</h2>
      </div>
      <div class="value-grid">
        {service.benefits.map((benefit) => (
          <article class="mini-card">
            <h3>{benefit}</h3>
          </article>
        ))}
      </div>
    </section>

    {detail?.considerations && (
      <section class="section-shell detail-grid compact-top" aria-labelledby="service-considerations-heading">
        <article class="detail-panel">
          <p class="eyebrow">Quality control</p>
          <h2 id="service-considerations-heading">Build safeguards into the workflow</h2>
          <p>Reliable content automation needs approved sources, structured handoffs and clear responsibility for the final decision.</p>
        </article>
        <article class="detail-panel">
          <ul class="feature-list">
            {detail.considerations.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </section>
    )}

    <section class="section-shell detail-grid compact-top">
      <article class="detail-panel">
        <p class="eyebrow">Ideal client</p>
        <h2>Best fit</h2>
        <ul class="feature-list">
          {service.idealClients.map((client) => <li>{client}</li>)}
        </ul>
      </article>
      <article class="detail-panel">
        <p class="eyebrow">Technology</p>
        <h2>Typical stack</h2>
        <ul class="pill-list">
          {service.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </article>
    </section>

    <section class="section-shell section-block compact-top">
      <div class="section-heading">
        <p class="eyebrow">Process</p>
        <h2>A focused path from idea to working system.</h2>
      </div>
      <div class="process-grid">
        {category.process.map((step, index) => (
          <article class="process-step">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell detail-grid compact-top">
      <article class="detail-panel">
        <p class="eyebrow">Pricing guidance</p>
        <h2>{packageKeys.includes(service.packageKey) ? packageLabels[service.packageKey] : "Project scope"}</h2>
        <p>{service.investment}</p>
        <a href={pricingHref}>See pricing structure</a>
      </article>
      <article class="detail-panel">
        <p class="eyebrow">Internal links</p>
        <h2>Related services</h2>
        <div class="link-grid">
          {relatedServices.map((item) => (
            <a href={`/${locale}/services/${item.slug}/`} data-track-event="related_service_click" data-track-label={`${service.slug}:${item.slug}`}>
              <span>{serviceCategoryDetails[item.category].eyebrow}</span>
              <strong>{item.title}</strong>
            </a>
          ))}
        </div>
      </article>
    </section>

    <section class="section-shell section-block compact-top faq-section">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2>Questions about {service.shortTitle.toLowerCase()}.</h2>
      </div>
      <div class="faq-list">
        {serviceFaqs.map((item) => <FAQ {...item} />)}
      </div>
    </section>

    <section class="section-shell inline-cta">
      <a class="button primary" href={contactHref} data-track-event="service_cta_click" data-track-label={`${service.slug}:bottom`}>{bottomCtaLabel}</a>
      <a class="button secondary" href={servicesHref}>Back to services overview</a>
    </section>

    <CTASection content={content} />
  </main>

  <script define:vars={{ serviceSlug: service.slug, serviceCategory: service.category }}>
    window.trackWebsiteliEvent?.("service_viewed", {
      event_category: "service",
      event_label: serviceSlug,
      service_slug: serviceSlug,
      service_category: serviceCategory,
    });

    if (serviceCategory === "automation") {
      window.trackWebsiteliEvent?.("automation_page_viewed", {
        event_category: "service",
        event_label: serviceSlug,
        service_slug: serviceSlug,
      });
    }
  </script>
</Layout>

<style>
  .pipeline-architecture .section-heading {
    max-width: 860px;
  }

  .pipeline-flow {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pipeline-flow li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 9px;
    min-width: 0;
    min-height: 210px;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 18px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    box-shadow: 0 14px 38px rgba(26, 32, 42, 0.06);
  }

  .pipeline-flow li:not(:last-child)::after {
    content: "→";
    position: absolute;
    z-index: 2;
    top: 50%;
    right: -13px;
    width: 26px;
    color: var(--brand);
    font-size: 1.25rem;
    font-weight: 900;
    text-align: center;
    transform: translateY(-50%);
  }

  .pipeline-step-number {
    color: var(--brand);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .pipeline-flow strong {
    color: var(--ink);
    line-height: 1.25;
  }

  .pipeline-flow small {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .pipeline-example {
    display: grid;
    gap: 24px;
    margin-top: 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: clamp(22px, 4vw, 34px);
    background: color-mix(in srgb, var(--surface) 90%, var(--brand) 10%);
  }

  .pipeline-example h3 {
    max-width: 760px;
    margin: 0;
  }

  .pipeline-example-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .pipeline-example-grid > div {
    border: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    border-radius: 8px;
    padding: 18px;
    background: color-mix(in srgb, var(--surface) 96%, transparent);
  }

  .pipeline-example-grid strong,
  .pipeline-example-grid p {
    margin: 0;
  }

  .pipeline-example-grid p {
    margin-top: 8px;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .pipeline-flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pipeline-flow li:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .pipeline-flow,
    .pipeline-example-grid {
      grid-template-columns: 1fr;
    }

    .pipeline-flow li {
      min-height: 0;
    }
  }
</style>
