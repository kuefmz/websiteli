---
import HomePage from "../../components/HomePage.astro";
import Layout from "../../layouts/Layout.astro";
import { getConversionHomeContent } from "../../content/home";
import { getAlternates, getLocaleContent, getLocalizedPath, localeCodes, type LocaleCode } from "../../content/locales";

export function getStaticPaths() {
  return localeCodes.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocaleCode;
const content = getLocaleContent(locale);
const home = getConversionHomeContent(locale);
const homeSeoByLocale: Partial<Record<LocaleCode, { title: string; description: string }>> = {
  en: {
    title: "Websiteli — Swiss Digital Consultancy",
    description:
      "Distinctive digital experiences, intelligent automation, data engineering and connected systems. Founder-led in Switzerland, with an international outlook.",
  },
  de: {
    title: "Webdesign Schweiz für KMU & Kleinunternehmen | Websiteli",
    description:
      "Webdesign für Schweizer KMU und Selbstständige: professionelle Websites mit Kontaktformular und SEO-Grundlagen. Projekte ansehen und Offerte anfragen.",
  },
};
const homeSeo = homeSeoByLocale[locale] ?? home.seo;
---

<Layout
  title={homeSeo.title}
  description={homeSeo.description}
  canonicalPath={getLocalizedPath(locale)}
  lang={locale}
  locale={locale}
  page="home"
  alternates={getAlternates("home")}
  content={content}
>
  <HomePage locale={locale} />
</Layout>
