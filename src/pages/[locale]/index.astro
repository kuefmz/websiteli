---
import HomePage from "../../components/HomePage.astro";
import Layout from "../../layouts/Layout.astro";
import { getConversionHomeContent } from "../../content/home";
import { getAlternates, getLocaleContent, getLocalizedPath, localeCodes, type LocaleCode } from "../../content/locales";

export function getStaticPaths() {
  return localeCodes.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocaleCode;
const content = getLocaleContent(locale);
const home = getConversionHomeContent(locale);
const homeSeoByLocale: Partial<Record<LocaleCode, { title: string; description: string }>> = {
  en: {
    title: "Swiss Web Design, Automation & AI for Small Businesses | Websiteli",
    description:
      "Swiss web design and technical implementation for small businesses: websites, SEO, analytics, automation, AI assistants and custom web apps. Websites from CHF 990.",
  },
  de: {
    title: "Webdesign, Automation & KI für KMU in der Schweiz | Websiteli",
    description:
      "Webdesign und technische Umsetzung für KMU in der Schweiz: Websites, SEO, Analytics, Automation, KI-Assistenten und individuelle Web-Apps. Websites ab CHF 990.",
  },
};
const homeSeo = homeSeoByLocale[locale] ?? home.seo;
---

<Layout
  title={homeSeo.title}
  description={homeSeo.description}
  canonicalPath={getLocalizedPath(locale)}
  lang={locale}
  locale={locale}
  page="home"
  alternates={getAlternates("home")}
  content={content}
>
  <HomePage locale={locale} />
</Layout>
