---
import { getLanguageCode } from "../content/locales";
import PremiumMotion from "../components/PremiumMotion.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnalyticsRuntime from "../components/AnalyticsRuntime.astro";
import AttributionRuntime from "../components/AttributionRuntime.astro";
import ExitIntentFeedback from "../components/ExitIntentFeedback.astro";
import InquiryRuntime from "../components/InquiryRuntime.astro";
import "../styles/global.css";
import "../styles/premium.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  lang?: string;
  locale?: string;
  page?: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  alternates?: { locale: string; href: string }[];
  content?: any;
  schema?: Record<string, any>[];
  includeDefaultFaq?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  lang = "en",
  locale = "en",
  page = "home",
  ogType = "website",
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  alternates = [],
  content,
  schema = [],
  includeDefaultFaq = false,
} = Astro.props;
const siteUrl = new URL("https://websiteli.ch");
const layoutCopy: Record<
  string,
  {
    businessDescription: string;
    areaServed: { type: "Country" | "Place"; name: string }[];
  }
> = {
  en: {
    businessDescription:
      "Founder-led Swiss digital consultancy for bespoke websites, intelligent automation, data engineering and connected business systems.",
    areaServed: [
      { type: "Country", name: "Switzerland" },
      { type: "Country", name: "Germany" },
      { type: "Country", name: "Austria" },
      { type: "Country", name: "Hungary" },
      { type: "Country", name: "Poland" },
      { type: "Country", name: "Czech Republic" },
      { type: "Country", name: "Slovakia" },
      { type: "Place", name: "International" },
    ],
  },
  de: {
    businessDescription:
      "Schweizer Digitalagentur für Business-Websites, SEO-Grundlagen, Website-Wartung, Business-Automation, KI-Assistenten, Dashboards und individuelle Webanwendungen.",
    areaServed: [
      { type: "Country", name: "Schweiz" },
      { type: "Country", name: "Deutschland" },
      { type: "Country", name: "Österreich" },
      { type: "Country", name: "Ungarn" },
      { type: "Country", name: "Polen" },
      { type: "Country", name: "Tschechien" },
      { type: "Country", name: "Slowakei" },
      { type: "Place", name: "International" },
    ],
  },
  fr: {
    businessDescription:
      "Agence digitale suisse pour sites web professionnels, bases SEO, maintenance, automatisation métier, assistants IA, tableaux de bord et applications web sur mesure.",
    areaServed: [
      { type: "Country", name: "Suisse" },
      { type: "Country", name: "Allemagne" },
      { type: "Country", name: "Autriche" },
      { type: "Country", name: "Hongrie" },
      { type: "Country", name: "Pologne" },
      { type: "Country", name: "Tchéquie" },
      { type: "Country", name: "Slovaquie" },
      { type: "Place", name: "International" },
    ],
  },
  it: {
    businessDescription:
      "Agenzia digitale svizzera per siti web aziendali, basi SEO, manutenzione siti, automazione aziendale, assistenti AI, dashboard e applicazioni web su misura.",
    areaServed: [
      { type: "Country", name: "Svizzera" },
      { type: "Country", name: "Germania" },
      { type: "Country", name: "Austria" },
      { type: "Country", name: "Ungheria" },
      { type: "Country", name: "Polonia" },
      { type: "Country", name: "Repubblica Ceca" },
      { type: "Country", name: "Slovacchia" },
      { type: "Place", name: "Internazionale" },
    ],
  },
};
const defaultLayoutCopy = layoutCopy[lang] ?? layoutCopy.en;
const businessDescription = defaultLayoutCopy.businessDescription;
const socialProfiles = [
  "https://www.youtube.com/@Websiteli",
  "https://www.linkedin.com/company/websiteli",
  "https://www.instagram.com/websiteli.ch/",
  "https://www.facebook.com/profile.php?id=61591131223104",
  "https://ch.pinterest.com/websiteli/",
];
function normalizeCanonicalPath(pathOrUrl: string) {
  const url = new URL(pathOrUrl, siteUrl);
  const lastSegment = url.pathname.split("/").pop() ?? "";
  const hasFileExtension = /\.[a-z0-9]+$/i.test(lastSegment);

  if (url.pathname === "/" || url.pathname.endsWith("/") || hasFileExtension) return url.pathname;
  return `${url.pathname}/`;
}
function toCanonicalUrl(pathOrUrl: string) {
  return new URL(normalizeCanonicalPath(pathOrUrl), siteUrl).toString();
}
const canonicalUrl = toCanonicalUrl(canonicalPath);
const imageUrl = new URL(image ?? "/assets/websiteli-og.png", siteUrl).toString();
const xDefaultHref = alternates.find((item) => item.locale === "en")?.href ?? "/en/";
const defaultFaqSchema = includeDefaultFaq
  ? [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: [
          {
            "@type": "Question",
            name: "Who owns a Websiteli website?",
            acceptedAnswer: { "@type": "Answer", text: "The client owns the domain, hosting access, source code, analytics accounts and website assets unless a separate third-party service requires its own terms." },
          },
          {
            "@type": "Question",
            name: "Does Websiteli offer website maintenance?",
            acceptedAnswer: { "@type": "Answer", text: "Yes. Websiteli offers monthly website maintenance with security updates, monitoring, backups, performance checks, small content changes, analytics reports, SEO monitoring and technical support." },
          },
          {
            "@type": "Question",
            name: "Can Websiteli help with SEO and Google Business?",
            acceptedAnswer: { "@type": "Answer", text: "Yes. Websiteli sets up technical SEO basics, metadata, Google Analytics, Google Search Console and Google Business Profile support as part of growth-focused packages." },
          },
        ],
      },
    ]
  : [];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Websiteli",
    url: siteUrl.toString(),
    email: "info@websiteli.ch",
    telephone: "+41772653306",
    logo: new URL("/assets/websiteli-logo.png", siteUrl).toString(),
    description: businessDescription,
    sameAs: socialProfiles,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Websiteli",
    url: siteUrl.toString(),
    inLanguage: getLanguageCode(lang),
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": new URL("/#professional-service", siteUrl).toString(),
    name: "Websiteli",
    url: siteUrl.toString(),
    email: "info@websiteli.ch",
    telephone: "+41772653306",
    areaServed: defaultLayoutCopy.areaServed.map((item) => ({
      "@type": item.type,
      name: item.name,
    })),
    description: businessDescription,
  },
  ...defaultFaqSchema,
  ...schema,
];
---

<!doctype html>
<html lang={getLanguageCode(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#e32635" />
    <meta name="msapplication-TileColor" content="#e32635" />
    <meta name="msapplication-config" content="/browserconfig.xml?v=3" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/assets/websiteli-logo.png?v=3" />
    <link rel="shortcut icon" type="image/png" href="/assets/websiteli-logo.png?v=3" />
    <link rel="apple-touch-icon" href="/assets/websiteli-logo.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    {alternates.map((item) => <link rel="alternate" hreflang={getLanguageCode(item.locale)} href={toCanonicalUrl(item.href)} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={toCanonicalUrl(xDefaultHref)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="websiteli.ch" />
    <meta property="og:locale" content={locale === "cz" ? "cs_CZ" : `${lang}_${({en:"GB",de:"CH",fr:"CH",it:"CH",hu:"HU",pl:"PL",es:"ES",sk:"SK",pt:"PT",da:"DK",nl:"NL",ja:"JP"})[lang] ?? "CH"}`} />
    <meta property="og:image" content={imageUrl} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="p:domain_verify" content="ac1419886e97f1aea245f6ba61ae70c7"/>
    <AttributionRuntime />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = storedTheme || (prefersDark ? "dark" : "light");
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <AnalyticsRuntime lang={lang} />
    <Header content={content} locale={locale} page={page} languageLinks={alternates} />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer content={content} locale={locale} />
    <ExitIntentFeedback locale={locale} />
    <InquiryRuntime />
    <PremiumMotion />
  </body>
</html>
