---
import { getLanguageCode } from "../content/locales";
import AnalyticsRuntime from "../components/AnalyticsRuntime.astro";
import AttributionRuntime from "../components/AttributionRuntime.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  lang?: string;
  alternates?: { locale: string; href: string }[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  lang = "en",
  alternates = [],
} = Astro.props;
const siteUrl = new URL("https://websiteli.ch");
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
---

<!doctype html>
<html lang={getLanguageCode(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0d1015" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(item => <link rel="alternate" hreflang={getLanguageCode(item.locale)} href={new URL(item.href, siteUrl).toString()} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates.find(item => item.locale === "en")?.href ?? alternates[0].href, siteUrl).toString()} />}
    <link rel="icon" type="image/png" href="/assets/websiteli-logo.png?v=3" />
    <link rel="apple-touch-icon" href="/assets/websiteli-logo.png?v=3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="websiteli.ch" />
    <meta property="og:image" content="https://websiteli.ch/assets/websiteli-og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://websiteli.ch/assets/websiteli-og.png" />
    <AttributionRuntime />
    <title>{title}</title>
  </head>
  <body>
    <AnalyticsRuntime lang={lang} />
    <slot />
  </body>
</html>
